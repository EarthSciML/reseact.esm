              }
            },
            "expr": {
              "op": "neg",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "rhoA",
                            "gi",
                            "gj",
                            "gk"
                          ]
