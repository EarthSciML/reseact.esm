        "Zagl": {
          "type": "observed",
          "units": "m",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Height above ground level, Z_agl = (Rd*Tv/g)*ln(PS/Pmid) with Rd=287.0 J/kg/K, g=9.81, and Pmid the layer-MIDPOINT pressure. NOTE: the shared EarthSciData GEOS-FP loader deliberately OMITS Z_agl because it needs Ap/Bp evaluated at the fractional level lev+0.5, which the ESM expression language cannot express (documented gaps gt-p3ep / gt-6ohw). reseact can compute it anyway: Pc IS that half-level pressure, 0.5*(Ap[k]+Ap[k+1]) + 0.5*(Bp[k]+Bp[k+1])*PS. Virtual temperature uses Tv = T*(1 + 0.608*q) with q ~ 0.622*VMR, i.e. Tv = Tc*(1 + 3.78e-10*H2Oc[ppb]).",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "Tc",
              "PS",
              "Pc",
              "H2Oc"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        287.0,
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "Tc",
                                "gi",
                                "gj",
                                "gk"
                              ]
                            },
                            {
                              "op": "+",
                              "args": [
                                1.0,
                                {
                                  "op": "*",
                                  "args": [
                                    3.78e-10,
                                    {
                                      "op": "index",
                                      "args": [
                                        "H2Oc",
                                        "gi",
                                        "gj",
                                        "gk"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    9.81
                  ]
                },
                {
                  "op": "log",
                  "args": [
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "PS",
                            "gi",
                            "gj"
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "Pc",
                            "gi",
                            "gj",
                            "gk"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
