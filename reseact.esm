    "SuperFastEmissionSource": {
      "variables": {
        "e_NO": {
          "type": "parameter",
          "units": "ppb/s",
          "default": 0.0,
          "description": "NO emission rate (from NEIRegrid.NO_emis)."
        },
        "e_NO2": {
          "type": "parameter",
          "units": "ppb/s",
          "default": 0.0,
          "description": "NO2 emission rate (from NEIRegrid.NO2_emis)."
        },
        "e_CO": {
          "type": "parameter",
          "units": "ppb/s",
          "default": 0.0,
          "description": "CO emission rate (from NEIRegrid.CO_emis)."
        },
        "e_ISOP": {
          "type": "parameter",
          "units": "ppb/s",
          "default": 0.0,
          "description": "ISOP emission rate (from NEIRegrid.ISOP_emis)."
        },
        "e_CH2O": {
          "type": "parameter",
          "units": "ppb/s",
          "default": 0.0,
          "description": "CH2O emission rate (from NEIRegrid.CH2O_emis)."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "SuperFast.NO"
            ],
            "wrt": "t"
          },
          "rhs": "e_NO"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "SuperFast.NO2"
            ],
            "wrt": "t"
          },
          "rhs": "e_NO2"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "SuperFast.CO"
            ],
            "wrt": "t"
          },
          "rhs": "e_CO"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "SuperFast.ISOP"
            ],
            "wrt": "t"
          },
          "rhs": "e_ISOP"
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "SuperFast.CH2O"
            ],
            "wrt": "t"
          },
          "rhs": "e_CH2O"
        }
      ]
    }
  },
  "index_sets": {
    "gf_t": {
      "kind": "interval",
      "size": 2
    },
    "gf_lev": {
      "kind": "interval",
      "size": 72
    },
    "gf_lat": {
      "kind": "interval",
      "size": 46
    },
    "gf_lon": {
      "kind": "interval",
      "size": 72
    },
    "nei_t": {
      "kind": "interval",
      "size": 1
    },
    "nei_lay": {
      "kind": "interval",
      "size": 1
    },
    "nei_row": {
      "kind": "interval",
      "size": "NEI_NY"
    },
    "nei_col": {
      "kind": "interval",
      "size": "NEI_NX"
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_I3.PS",
      "to": "Transport3D.F_PS",
      "transform": "param_to_var",
      "description": "GEOS-FP I3 surface pressure (hPa in file) -> the native-slice PS. Note the subsystem key is GEOSFP_I3, not I3."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.U",
      "to": "Transport3D.F_U",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn eastward wind -> the zonal face flux Mx."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.V",
      "to": "Transport3D.F_V",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn northward wind -> the meridional face flux My."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.OMEGA",
      "to": "Transport3D.F_OM",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn OMEGA -> the vertical face flux Mz = -OMEGA."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.PBLH",
      "to": "Transport3D.F_PBLH",
      "transform": "param_to_var",
      "description": "GEOS-FP A1 boundary-layer height -> carried for Kzz."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_I3",
      "to": "Transport3D.w_I3",
      "transform": "param_to_var",
      "description": "I3 cadence weight -> the PS two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_A3",
      "to": "Transport3D.w_A3",
      "transform": "param_to_var",
      "description": "A3 cadence weight -> the U/V/OMEGA two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_A1",
      "to": "Transport3D.w_A1",
      "transform": "param_to_var",
      "description": "A1 cadence weight -> the PBLH two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_I3.T",
      "to": "Transport3D.F_T",
      "transform": "param_to_var",
      "description": "GEOS-FP I3 temperature -> the native-slice Tc."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.RH",
      "to": "Transport3D.F_RH",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn relative humidity -> the native-slice H2Oc. A3dyn cadence, so it reuses w_A3."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.TS",
      "to": "Transport3D.F_TS",
      "transform": "param_to_var",
      "description": "GEOS-FP TS -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.Z0M",
      "to": "Transport3D.F_Z0M",
      "transform": "param_to_var",
      "description": "GEOS-FP Z0M -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.USTAR",
      "to": "Transport3D.F_USTAR",
      "transform": "param_to_var",
      "description": "GEOS-FP USTAR -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.SWGDN",
      "to": "Transport3D.F_SWGDN",
      "transform": "param_to_var",
      "description": "GEOS-FP SWGDN -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.HFLUX",
      "to": "Transport3D.F_HFLUX",
      "transform": "param_to_var",
      "description": "GEOS-FP HFLUX -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3cld.CLOUD",
      "to": "Transport3D.F_CLOUD",
      "transform": "param_to_var",
      "description": "GEOS-FP CLOUD -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3mstE.PFLCU",
      "to": "Transport3D.F_PFLCU",
      "transform": "param_to_var",
      "description": "GEOS-FP PFLCU -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3mstE.PFLLSAN",
      "to": "Transport3D.F_PFLLSAN",
      "transform": "param_to_var",
      "description": "GEOS-FP PFLLSAN -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Tc",
      "to": "SuperFast.T",
      "transform": "param_to_var",
      "description": "Per-cell GEOS-FP temperature -> SuperFast's scalar T param. param_to_var carries the [lon,lat,lev] shape so the pointwise lift indexes it per cell; the rate constants then vary with the real 3-D temperature field."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Pc",
      "to": "SuperFast.P",
      "transform": "param_to_var",
      "description": "Per-cell hybrid mid-layer pressure -> SuperFast's scalar P param."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.H2Oc",
      "to": "SuperFast.H2O",
      "transform": "param_to_var",
      "description": "Per-cell water vapour -> SuperFast's H2O constant-species reservoir, matching GasChem.jl's couple2(SuperFastCoupler, GEOSFPCoupler), which param_to_var's :T, :P AND :H2O together. Without this the mechanism and the photolysis would disagree about humidity: H2O enters SuperFast through H2O + NO2 -> 0.5 HNO3 and through the water enhancement of HO2 + HO2 -> H2O2."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.cos_sza_c",
      "to": "FastJX.cos_sza",
      "transform": "param_to_var",
      "description": "Per-cell cosine of the solar zenith angle -> FastJX's scalar cos_sza param. This is the ONE solar input of the interpolated Fast-JX component: it takes cos_sza directly and does not compute the solar position from lat/lon/t_utc the way the sibling fastjx.esm does. That is exactly why this variant is the one mounted here — computing cos_sza on this side (Transport3D.cos_sza_c) keeps the whole chain to pure arithmetic and out of datetime.*, so it can depend on the solver time t AND survive a Reactant trace. cos_sza then drives the 18-band bilinear actinic-flux lookup over (cos_sza, P)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Tc",
      "to": "FastJX.T",
      "transform": "param_to_var",
      "description": "Per-cell GEOS-FP temperature -> FastJX's scalar T param. The SAME field SuperFast.T reads, so cross sections, quantum yields and rate constants all see one temperature. T enters every sigma_X / phi_O31D interp.linear and the O(1D) quenching rates."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Pc",
      "to": "FastJX.P",
      "transform": "param_to_var",
      "description": "Per-cell hybrid mid-layer pressure -> FastJX's scalar P param. Sets the air number density used by the O(1D) quenching balance (and would be one axis of the actinic-flux lookup in the interpolated Fast-JX variant)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.H2Oc",
      "to": "FastJX.H2O",
      "transform": "param_to_var",
      "description": "Per-cell water vapour -> FastJX's H2O param, matching GasChem.jl's couple2(FastJXCoupler, GEOSFPCoupler). Sets j_O31D_adj = RO1DplH2O/RO1D and hence the effective j_o32OH."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.TSc",
      "to": "DryDepositionGas.Ts",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Zagl",
      "to": "DryDepositionGas.z",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.delP1",
      "to": "DryDepositionGas.del_P",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Z0Mc",
      "to": "DryDepositionGas.z0",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.USTARc",
      "to": "DryDepositionGas.u_star",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.SWGDNc",
      "to": "DryDepositionGas.G",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.rhoA",
      "to": "DryDepositionGas.rho_A",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Lmo",
      "to": "DryDepositionGas.L",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.levc",
      "to": "DryDepositionGas.lev",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.cloudFracc",
      "to": "WetDeposition.cloudFrac",
      "transform": "param_to_var",
      "description": "EMEP wet-deposition driver, matching AtmosphericDeposition.jl couple2(WetDepositionCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.rhoA",
      "to": "WetDeposition.rho_air",
      "transform": "param_to_var",
      "description": "EMEP wet-deposition driver, matching AtmosphericDeposition.jl couple2(WetDepositionCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.qrainc",
      "to": "WetDeposition.qrain",
      "transform": "param_to_var",
      "description": "EMEP wet-deposition driver, matching AtmosphericDeposition.jl couple2(WetDepositionCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.levc",
      "to": "WetDeposition.lev",
      "transform": "param_to_var",
      "description": "EMEP wet-deposition driver, matching AtmosphericDeposition.jl couple2(WetDepositionCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "DryDepositionGas.k_O3",
      "to": "SuperFastDepositionSink.k_O3",
      "transform": "param_to_var",
      "description": "First-order dry-deposition loss coefficient -> the SuperFast sink applicator. Species mapping mirrors AtmosphericDeposition.jl ext/GasChemExt.jl couple2(SuperFastCoupler, DryDepositionGasCoupler): O3<-k_O3, NO2<-k_NO2, NO<-k_NO2 (NO reuses NO2's rate), HNO3<-k_HNO3, H2O2<-k_H2O2, CH2O<-k_HCHO."
    },
    {
      "type": "variable_map",
      "from": "DryDepositionGas.k_NO2",
      "to": "SuperFastDepositionSink.k_NO2",
      "transform": "param_to_var",
      "description": "First-order dry-deposition loss coefficient -> the SuperFast sink applicator. Species mapping mirrors AtmosphericDeposition.jl ext/GasChemExt.jl couple2(SuperFastCoupler, DryDepositionGasCoupler): O3<-k_O3, NO2<-k_NO2, NO<-k_NO2 (NO reuses NO2's rate), HNO3<-k_HNO3, H2O2<-k_H2O2, CH2O<-k_HCHO."
    },
    {
      "type": "variable_map",
      "from": "DryDepositionGas.k_HNO3",
      "to": "SuperFastDepositionSink.k_HNO3",
      "transform": "param_to_var",
      "description": "First-order dry-deposition loss coefficient -> the SuperFast sink applicator. Species mapping mirrors AtmosphericDeposition.jl ext/GasChemExt.jl couple2(SuperFastCoupler, DryDepositionGasCoupler): O3<-k_O3, NO2<-k_NO2, NO<-k_NO2 (NO reuses NO2's rate), HNO3<-k_HNO3, H2O2<-k_H2O2, CH2O<-k_HCHO."
    },
    {
      "type": "variable_map",
      "from": "DryDepositionGas.k_H2O2",
      "to": "SuperFastDepositionSink.k_H2O2",
      "transform": "param_to_var",
      "description": "First-order dry-deposition loss coefficient -> the SuperFast sink applicator. Species mapping mirrors AtmosphericDeposition.jl ext/GasChemExt.jl couple2(SuperFastCoupler, DryDepositionGasCoupler): O3<-k_O3, NO2<-k_NO2, NO<-k_NO2 (NO reuses NO2's rate), HNO3<-k_HNO3, H2O2<-k_H2O2, CH2O<-k_HCHO."
    },
    {
      "type": "variable_map",
      "from": "DryDepositionGas.k_HCHO",
      "to": "SuperFastDepositionSink.k_HCHO",
      "transform": "param_to_var",
      "description": "First-order dry-deposition loss coefficient -> the SuperFast sink applicator. Species mapping mirrors AtmosphericDeposition.jl ext/GasChemExt.jl couple2(SuperFastCoupler, DryDepositionGasCoupler): O3<-k_O3, NO2<-k_NO2, NO<-k_NO2 (NO reuses NO2's rate), HNO3<-k_HNO3, H2O2<-k_H2O2, CH2O<-k_HCHO."
    },
    {
      "type": "variable_map",
      "from": "WetDeposition.k_othergas",
      "to": "SuperFastDepositionSink.k_wet",
      "transform": "param_to_var",
      "description": "Lumped soluble-gas wet-scavenging coefficient -> the sink applicator, applied to HNO3, H2O2, CH2O and CH3OOH exactly as couple2(SuperFastCoupler, WetDepositionCoupler) does."
    },
    {
      "type": "variable_map",
      "from": "FastJX.j_H2O2",
      "to": "SuperFast.jH2O2",
      "transform": "param_to_var",
      "description": "H2O2 + hv -> 2 OH. One of the six edges of the EarthSciModels coupling library couplings/fastjx_superfast.esm (roles Photolysis=FastJX, Chem=SuperFast), SPELLED OUT here rather than pulled in with coupling_import: a coupling_import `ref` is resolved by flatten against its `base_path` kwarg, which defaults to the process working directory (unlike a `models`/`reaction_systems` `ref`, resolved at load against the FILE's directory), so an imported edge would silently depend on where julia was started. These six replace SuperFast's fixed j-parameter defaults with the time/place/temperature-dependent Fast-JX rates, so photolysis now varies across the slice instead of being one hard-coded noon value."
    },
    {
      "type": "variable_map",
      "from": "FastJX.j_H2COa",
      "to": "SuperFast.jH2COa",
      "transform": "param_to_var",
      "description": "CH2O + hv -> CO + HO2 + H (radical channel)."
    },
    {
      "type": "variable_map",
      "from": "FastJX.j_H2COb",
      "to": "SuperFast.jH2COb",
      "transform": "param_to_var",
      "description": "CH2O + hv -> CO + H2 (molecular channel)."
    },
    {
      "type": "variable_map",
      "from": "FastJX.j_CH3OOH",
      "to": "SuperFast.jCH3OOH",
      "transform": "param_to_var",
      "description": "CH3OOH + hv -> CH3O + OH."
    },
    {
      "type": "variable_map",
      "from": "FastJX.j_NO2",
      "to": "SuperFast.jNO2",
      "transform": "param_to_var",
      "description": "NO2 + hv -> NO + O; drives the NOx-O3 photostationary state, and so is the edge the O3 field is most sensitive to."
    },
    {
      "type": "variable_map",
      "from": "FastJX.j_o32OH",
      "to": "SuperFast.jO32OH",
      "transform": "param_to_var",
      "description": "Effective O3 + hv -> 2 OH: j_O31D times the fraction of O(1D) that reacts with H2O rather than being quenched by N2/O2/H2 (FastJX.j_O31D_adj). This is why FastJX.H2O has to agree with SuperFast's H2O reservoir."
    },
    {
      "type": "operator_compose",
      "systems": [
        "SuperFastDepositionSink",
        "SuperFast"
      ],
      "description": "Add the deposition sink terms onto the SuperFast species ODEs. SuperFastDepositionSink carries D(SuperFast.X) ~ -(k_dry + k_wet)*SuperFast.X equations; operator_compose sums RHS contributions that share a dependent variable, so each species' chemistry tendency gains its loss term (dc/dt += -k*c). Placed BEFORE the SuperFast/Transport3D pointwise compose so the sink is already merged into D(SuperFast.X) when the lift array-ifies it. Per the component's own note this MUST be operator_compose, not a couple/additive connector -- the flatten pipeline silently discards the latter."
    },
    {
      "type": "variable_map",
      "from": "NEI2016Emis.NEI2016.NO",
      "to": "NEIRegrid.F_NO",
      "transform": "param_to_var",
      "description": "NEI2016 NO LOADER field -> the native 12US1 array the regrid reads. Coupled from the loader field rather than the component's pointwise NO observed on purpose: reseact wants the whole source grid to regrid conservatively, not one bilinear sample at each 4x5 cell centre, which would draw a ~400 km cell's emissions from a single 12 km cell. Same shape of decision as GEOSFP.GEOSFP_I3.PS -> Transport3D.F_PS."
    },
    {
      "type": "variable_map",
      "from": "NEI2016Emis.NEI2016.NO2",
      "to": "NEIRegrid.F_NO2",
      "transform": "param_to_var",
      "description": "NEI2016 NO2 LOADER field -> the native 12US1 array the regrid reads. Coupled from the loader field rather than the component's pointwise NO2 observed on purpose: reseact wants the whole source grid to regrid conservatively, not one bilinear sample at each 4x5 cell centre, which would draw a ~400 km cell's emissions from a single 12 km cell. Same shape of decision as GEOSFP.GEOSFP_I3.PS -> Transport3D.F_PS."
    },
    {
      "type": "variable_map",
      "from": "NEI2016Emis.NEI2016.CO",
      "to": "NEIRegrid.F_CO",
      "transform": "param_to_var",
      "description": "NEI2016 CO LOADER field -> the native 12US1 array the regrid reads. Coupled from the loader field rather than the component's pointwise CO observed on purpose: reseact wants the whole source grid to regrid conservatively, not one bilinear sample at each 4x5 cell centre, which would draw a ~400 km cell's emissions from a single 12 km cell. Same shape of decision as GEOSFP.GEOSFP_I3.PS -> Transport3D.F_PS."
    },
    {
      "type": "variable_map",
      "from": "NEI2016Emis.NEI2016.ISOP",
      "to": "NEIRegrid.F_ISOP",
      "transform": "param_to_var",
      "description": "NEI2016 ISOP LOADER field -> the native 12US1 array the regrid reads. Coupled from the loader field rather than the component's pointwise ISOP observed on purpose: reseact wants the whole source grid to regrid conservatively, not one bilinear sample at each 4x5 cell centre, which would draw a ~400 km cell's emissions from a single 12 km cell. Same shape of decision as GEOSFP.GEOSFP_I3.PS -> Transport3D.F_PS."
    },
    {
      "type": "variable_map",
      "from": "NEI2016Emis.NEI2016.FORM",
      "to": "NEIRegrid.F_FORM",
      "transform": "param_to_var",
      "description": "NEI2016 FORM LOADER field -> the native 12US1 array the regrid reads. Coupled from the loader field rather than the component's pointwise FORM observed on purpose: reseact wants the whole source grid to regrid conservatively, not one bilinear sample at each 4x5 cell centre, which would draw a ~400 km cell's emissions from a single 12 km cell. Same shape of decision as GEOSFP.GEOSFP_I3.PS -> Transport3D.F_PS."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.delP1",
      "to": "NEIRegrid.delp",
      "transform": "param_to_var",
      "description": "Live first-level pressure thickness -> the emissions' flux-to-mixing-ratio divisor. The same field DryDepositionGas.del_P reads."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.levc",
      "to": "NEIRegrid.lev",
      "transform": "param_to_var",
      "description": "Vertical index as a field -> the surface-only emission gate, exactly as DryDepositionGas.lev gates deposition."
    },
    {
      "type": "variable_map",
      "from": "NEIRegrid.NO_emis",
      "to": "SuperFastEmissionSource.e_NO",
      "transform": "param_to_var",
      "description": "Per-cell NO emission rate (ppb/s) -> the SuperFast source applicator."
    },
    {
      "type": "variable_map",
      "from": "NEIRegrid.NO2_emis",
      "to": "SuperFastEmissionSource.e_NO2",
      "transform": "param_to_var",
      "description": "Per-cell NO2 emission rate (ppb/s) -> the SuperFast source applicator."
    },
    {
      "type": "variable_map",
      "from": "NEIRegrid.CO_emis",
      "to": "SuperFastEmissionSource.e_CO",
      "transform": "param_to_var",
      "description": "Per-cell CO emission rate (ppb/s) -> the SuperFast source applicator."
    },
    {
      "type": "variable_map",
      "from": "NEIRegrid.ISOP_emis",
      "to": "SuperFastEmissionSource.e_ISOP",
      "transform": "param_to_var",
      "description": "Per-cell ISOP emission rate (ppb/s) -> the SuperFast source applicator."
    },
    {
      "type": "variable_map",
      "from": "NEIRegrid.CH2O_emis",
      "to": "SuperFastEmissionSource.e_CH2O",
      "transform": "param_to_var",
      "description": "Per-cell CH2O emission rate (ppb/s) -> the SuperFast source applicator."
    },
    {
      "type": "operator_compose",
      "systems": [
        "SuperFastEmissionSource",
        "SuperFast"
      ],
      "description": "Add the NEI2016 emission source terms onto the SuperFast species ODEs. SuperFastEmissionSource carries D(SuperFast.X) ~ +e_X equations; operator_compose sums them into the mechanism's own tendencies, mirroring SuperFastDepositionSink one entry above. Species mapping (NO, NO2, CO, ISOP, FORM->CH2O) and the 1e9*MW_air/MW_X unit factors are GasChem.jl couple2(SuperFastCoupler, NEI2016MonthlyEmisCoupler) verbatim; CH4 is omitted because it is a fixed species in SuperFast, and NEI's SO2/SULF have no SuperFast counterpart."
    },
    {
      "type": "operator_compose",
      "systems": [
        "SuperFast",
        "Transport3D"
      ],
      "lifting": "pointwise",
      "description": "Lift the 0-D SuperFast mechanism onto the 7x7x7 grid and add each species' PPM advection contribution to its reaction tendency. pointwise lifting evaluates the network independently per cell; the merged reaction+advection state ODEs are array-ified by the flattener's lift. Only the 12 non-constant species lift — O2/CH4/H2O are constant:true reservoirs with no ODE, so they broadcast into the rates instead."
    }
  ],
  "reaction_systems": {
    "SuperFast": {
      "ref": "../EarthSciModels/components/gaschem/superfast.esm"
    }
  }
}
