              "m"
            ]
          }
        },
        {
          "_comment": "d(H2O2)/dt advection contribution, flux-form PPM in CWC mixing-ratio form: [-div(M q) + q div(M)]/m, with H2O2's OWN lateral inflow halo bound to the rule's qbc params. operator_compose merges this with H2O2's reaction tendency and the pointwise lift array-ifies the result.",
          "lhs": {
            "op": "D",
            "args": [
              "SuperFast.H2O2"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "+",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "Mx",
                                  "SuperFast.H2O2"
                                ]
                              },
                              "qbc_w_H2O2",
                              "qbc_e_H2O2"
                            ],
                            "wrt": "lon"
                          },
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "My",
                                  "SuperFast.H2O2"
                                ]
                              },
                              "qbc_s_H2O2",
                              "qbc_n_H2O2"
                            ],
                            "wrt": "lat"
                          },
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "Mz",
                                  "SuperFast.H2O2"
                                ]
                              }
                            ],
                            "wrt": "lev"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "SuperFast.H2O2",
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "D",
                            "args": [
                              "Mx"
                            ],
                            "wrt": "lon"
                          },
                          {
                            "op": "D",
                            "args": [
                              "My"
                            ],
                            "wrt": "lat"
                          },
                          {
                            "op": "D",
                            "args": [
                              "Mz"
                            ],
                            "wrt": "lev"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "m"
            ]
          }
        },
        {
          "_comment": "d(CH3O2)/dt advection contribution, flux-form PPM in CWC mixing-ratio form: [-div(M q) + q div(M)]/m, with CH3O2's OWN lateral inflow halo bound to the rule's qbc params. operator_compose merges this with CH3O2's reaction tendency and the pointwise lift array-ifies the result.",
          "lhs": {
            "op": "D",
            "args": [
              "SuperFast.CH3O2"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "+",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "Mx",
                                  "SuperFast.CH3O2"
                                ]
                              },
                              "qbc_w_CH3O2",
                              "qbc_e_CH3O2"
                            ],
                            "wrt": "lon"
                          },
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "My",
                                  "SuperFast.CH3O2"
                                ]
                              },
                              "qbc_s_CH3O2",
                              "qbc_n_CH3O2"
                            ],
                            "wrt": "lat"
                          },
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "Mz",
                                  "SuperFast.CH3O2"
                                ]
                              }
                            ],
                            "wrt": "lev"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "SuperFast.CH3O2",
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "D",
                            "args": [
                              "Mx"
                            ],
                            "wrt": "lon"
                          },
                          {
                            "op": "D",
                            "args": [
                              "My"
                            ],
                            "wrt": "lat"
                          },
                          {
                            "op": "D",
                            "args": [
                              "Mz"
                            ],
                            "wrt": "lev"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "m"
            ]
          }
        },
        {
          "_comment": "d(CH2O)/dt advection contribution, flux-form PPM in CWC mixing-ratio form: [-div(M q) + q div(M)]/m, with CH2O's OWN lateral inflow halo bound to the rule's qbc params. operator_compose merges this with CH2O's reaction tendency and the pointwise lift array-ifies the result.",
          "lhs": {
            "op": "D",
            "args": [
              "SuperFast.CH2O"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "/",
            "args": [
              {
                "op": "+",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "Mx",
                                  "SuperFast.CH2O"
                                ]
                              },
                              "qbc_w_CH2O",
                              "qbc_e_CH2O"
                            ],
                            "wrt": "lon"
                          },
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "My",
                                  "SuperFast.CH2O"
                                ]
                              },
                              "qbc_s_CH2O",
                              "qbc_n_CH2O"
                            ],
                            "wrt": "lat"
                          },
                          {
                            "op": "D",
                            "args": [
                              {
                                "op": "*",
                                "args": [
                                  "Mz",
                                  "SuperFast.CH2O"
                                ]
                              }
                            ],
                            "wrt": "lev"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "SuperFast.CH2O",
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "D",
                            "args": [
                              "Mx"
                            ],
                            "wrt": "lon"
                          },
                          {
                            "op": "D",
                            "args": [
                              "My"
                            ],
                            "wrt": "lat"
                          },
                          {
                            "op": "D",
                            "args": [
                              "Mz"
                            ],
                            "wrt": "lev"
                          }
                        ]
                      }
                    ]
