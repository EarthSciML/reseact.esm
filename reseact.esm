        },
        "dB": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lev"
          ],
          "default": 0.0,
          "description": "dB[k] = Bp[k]-Bp[k+1] from the native GEOS-FP hybrid table at integer edges k=1..8. Supplied via const_arrays."
        },
        "PS": {
          "type": "observed",
          "units": "Pa",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Surface pressure (Pa) on the local grid: the GEOS-FP I3 field at NATIVE (lat=29+j, lon=14+i), blended across its two bracketing records with w_I3 and scaled hPa->Pa. Replaces the Stage-B constant 101325. Drives dp = dA[k] + dB[k]*PS, so the hybrid vertical breathes with the real surface pressure.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj"
