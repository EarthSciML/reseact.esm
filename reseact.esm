  "coupling": [
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_I3.PS",
      "to": "Transport3D.F_PS",
      "transform": "param_to_var",
      "description": "GEOS-FP I3 surface pressure (hPa in file) -> the native-slice PS. Note the subsystem key is GEOSFP_I3, not I3."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.U",
      "to": "Transport3D.F_U",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn eastward wind -> the zonal face flux Mx."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.V",
      "to": "Transport3D.F_V",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn northward wind -> the meridional face flux My."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.OMEGA",
      "to": "Transport3D.F_OM",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn OMEGA -> the vertical face flux Mz = -OMEGA."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.PBLH",
      "to": "Transport3D.F_PBLH",
      "transform": "param_to_var",
      "description": "GEOS-FP A1 boundary-layer height -> carried for Kzz."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_I3",
      "to": "Transport3D.w_I3",
      "transform": "param_to_var",
      "description": "I3 cadence weight -> the PS two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_A3",
      "to": "Transport3D.w_A3",
      "transform": "param_to_var",
      "description": "A3 cadence weight -> the U/V/OMEGA two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_A1",
      "to": "Transport3D.w_A1",
      "transform": "param_to_var",
      "description": "A1 cadence weight -> the PBLH two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_I3.T",
      "to": "Transport3D.F_T",
      "transform": "param_to_var",
      "description": "GEOS-FP I3 temperature -> the native-slice Tc."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.RH",
      "to": "Transport3D.F_RH",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn relative humidity -> the native-slice H2Oc. A3dyn cadence, so it reuses w_A3."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.TS",
      "to": "Transport3D.F_TS",
      "transform": "param_to_var",
      "description": "GEOS-FP TS -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.Z0M",
      "to": "Transport3D.F_Z0M",
      "transform": "param_to_var",
      "description": "GEOS-FP Z0M -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.USTAR",
