                    },
                    {
                      "op": "/",
                      "args": [
                        1.0,
                        "days_in_month"
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        "g0",
                        {
                          "op": "index",
                          "args": [
                            "delp",
                            "gi",
                            "gj",
                            "gk"
                          ]
                        }
                      ]
                    },
                    "scale",
                    {
                      "op": "index",
                      "args": [
                        "diurnal_factor_nox",
                        "gi"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "dayofweek_nox",
                        "gi"
                      ]
                    }
                  ]
                },
                0.0
              ]
            }
          },
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        },
        "CO_emis": {
          "type": "observed",
          "units": "ppb/s",
          "description": "NEI2016 CO emission rate for SuperFast.CO, ppb/s, in the surface layer only. Chain: the regridded month-integrated flux density E_CO / days_in_month -> a true per-second flux; / (delp/g0) [kg/m^2] -> kg/kg/s; x 1e9*MW_air/MW_species -> ppb/s. The unit factor is spelled 1e9*0.02897/0.0280101 so its provenance stays legible: it is uconv/MW_X from GasChem.jl couple2(SuperFastCoupler, NEI2016MonthlyEmisCoupler), the same constant EarthSciModels/couplings/nei2016_superfast.esm carries. The upstream component's dimensionless Dz placeholder is dropped (it is 1.0 there, and a no-op).",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "args": [
              "Exy_CO",
              "delp",
              "diurnal_factor",
              "dayofweek_co"
            ],
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<",
                  "args": [
                    "gk",
