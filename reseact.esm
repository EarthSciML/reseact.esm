          ],
          "default": 0.0,
          "description": "GEOS-FP hybrid sigma-pressure Bp coefficients at the NLEV+1 layer edges (dimensionless). Supplied via const_arrays."
        },
        "Pc": {
          "type": "observed",
          "units": "Pa",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Air pressure (Pa) at each layer's mid-point: the mean of its two hybrid sigma-pressure edges, P_edge(k) = Ap[k] + Bp[k]*PS(i,j,t). Breathes with the real surface pressure. Coupled into SuperFast.P.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "Ap",
              "Bp",
              "PS"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                0.5,
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "Ap",
                            "gk"
                          ]
                        },
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "Bp",
                                "gk"
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "PS",
                                "gi",
                                "gj"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "Ap",
                            {
                              "op": "+",
                              "args": [
                                "gk",
                                1
                              ]
                            }
                          ]
                        },
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "Bp",
                                {
                                  "op": "+",
                                  "args": [
                                    "gk",
                                    1
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "PS",
                                "gi",
                                "gj"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "latp": {
          "type": "observed",
          "units": "deg",
          "shape": [
            "lat"
          ],
          "description": "Latitude of each lat POINT, lat_j = lat0_deg + (j-1)*dlat_deg, from the latlon grid's own lat_coord template (the same producer lat_edge folds from). Pure geometry, no forcing. Feeds latc.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lat_coord",
            "bindings": {}
          }
        },
        "lonp": {
          "type": "observed",
          "units": "deg",
          "shape": [
            "lon"
          ],
          "description": "Longitude of each lon cell CENTRE, lon_i = lon0_deg + (i-1/2)*dlon_deg, from the latlon grid's own lon_coord template (lon0_deg is the west EDGE, hence the half-cell shift). Feeds lonc.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lon_coord",
            "bindings": {}
          }
        },
        "doy0": {
          "type": "observed",
          "units": "1",
          "description": "Day of year (1..366) of the model's t=0 epoch. The model's time base: solver time t is seconds since 2013-01-01T00:00:00Z (unix 1356998400), the GEOS-FP day the meteorology is read from — so the runners' T0 = 64800 is 18:00Z that day. Retarget the run to another date by editing doy0 / hour0 / min0 / sec0 together with the GEOS-FP URL in prototypes/reseact_3d_chem/split_common.jl `reseact_forcing`.",
          "expression": 1.0
        },
        "hour0": {
          "type": "observed",
          "units": "1",
          "description": "UTC hour of the model's t=0 epoch. See doy0.",
          "expression": 0.0
        },
        "min0": {
          "type": "observed",
          "units": "1",
          "description": "UTC minute of the model's t=0 epoch. See doy0.",
          "expression": 0.0
        },
        "sec0": {
          "type": "observed",
          "units": "1",
          "description": "UTC second of the model's t=0 epoch. See doy0.",
          "expression": 0.0
        },
        "gamma_s": {
          "type": "observed",
          "units": "rad",
          "description": "NOAA fractional-year angle gamma = 0.01721420632103996 * ((doy0-1) + (hour0-12)/24 + t/86400).\n\nThis is fastjx.esm's `gamma` with ONE change: the elapsed-time term t/86400 replaces the calendar decomposition of a UTC timestamp. That change is what lets the sun MOVE with the solve. The upstream form calls datetime.day_of_year / datetime.hour on t_utc, which EarthSciAST evaluates as opaque host calls (Dates.unix2datetime) — they cannot take the solver's t, and under Reactant they cannot even take a literal, because the tree-walk evaluator lowers every leaf as convert(T, ...) and T is a TracedRNumber. Decomposing the calendar ONCE at the epoch (doy0/hour0/min0/sec0 above, plain literals) and advancing it with arithmetic is exact, traceable, and continuous.\n\nAgrees with the upstream form to the last bit whenever t is a whole number of hours past the epoch; between hours it is strictly BETTER, because upstream's `hour` is an integer truncation that steps gamma once an hour (a ~7e-4 rad phase error) while this is smooth.",
          "expression": {
            "op": "*",
            "args": [
              0.01721420632103996,
              {
                "op": "+",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "doy0",
                      1.0
                    ]
                  },
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          "hour0",
                          12.0
                        ]
                      },
                      24.0
                    ]
                  },
                  {
                    "op": "/",
                    "args": [
                      "t",
                      86400.0
                    ]
                  }
                ]
              }
            ]
          }
        },
        "decl_s": {
          "type": "observed",
          "units": "rad",
          "description": "Solar declination (rad) — Spencer (1971) 6-term Fourier series in gamma_s. Term for term identical to fastjx.esm `solar_declination`.",
          "expression": {
            "op": "+",
            "args": [
              0.006918,
              {
                "op": "*",
                "args": [
                  -0.399912,
                  {
                    "op": "cos",
                    "args": [
                      "gamma_s"
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.070257,
                  {
                    "op": "sin",
                    "args": [
                      "gamma_s"
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  -0.006758,
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          2.0,
                          "gamma_s"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.000907,
                  {
                    "op": "sin",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          2.0,
                          "gamma_s"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  -0.002697,
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          3.0,
                          "gamma_s"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.00148,
                  {
                    "op": "sin",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          3.0,
                          "gamma_s"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "eqtime_s": {
          "type": "observed",
          "units": "1",
          "description": "Equation of time (minutes): 229.18*(0.000075 + 0.001868 cos g - 0.032077 sin g - 0.014615 cos 2g - 0.040849 sin 2g). Identical to fastjx.esm `equation_of_time`.",
          "expression": {
            "op": "*",
            "args": [
              229.18,
              {
                "op": "+",
                "args": [
                  7.5e-05,
                  {
                    "op": "*",
                    "args": [
                      0.001868,
                      {
                        "op": "cos",
                        "args": [
                          "gamma_s"
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      -0.032077,
                      {
                        "op": "sin",
                        "args": [
                          "gamma_s"
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      -0.014615,
                      {
                        "op": "cos",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              2.0,
                              "gamma_s"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      -0.040849,
                      {
                        "op": "sin",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              2.0,
                              "gamma_s"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "tstmin_s": {
          "type": "observed",
          "units": "1",
          "description": "True solar time at the PRIME MERIDIAN, in minutes since midnight: hour0*60 + min0 + sec0/60 + t/60 + eqtime_s. The per-cell 4*lon term (4 min per degree east) is added inside cos_sza_c, so this stays scalar and only the cheap longitude offset is done per cell.",
          "expression": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "hour0",
                  60.0
                ]
              },
              "min0",
              {
                "op": "/",
                "args": [
                  "sec0",
                  60.0
                ]
              },
              {
                "op": "/",
                "args": [
                  "t",
                  60.0
                ]
              },
              "eqtime_s"
            ]
          }
        },
        "cos_sza_c": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Cosine of the solar zenith angle per cell: clamp(sin(lat)sin(decl) + cos(lat)cos(decl)cos(w), -1, 1), with hour angle w = (pi/180)*((tstmin_s + 4*lon)/4 - 180). Coupled into FastJX.cos_sza — the single solar input of the interpolated Fast-JX component, which (unlike fastjx.esm) does NOT compute the solar position itself.\n\nShaped [lon,lat,lev] even though it is invariant in lev: every FastJX input (cos_sza, T, P) then carries the SAME axes, so the shape promotion that lifts the 0-D photolysis chain onto the grid never has to align differently-shaped operands by name. The duplicated column costs one extra observed and nothing at all in the j-rates, which are recomputed per cell regardless.\n\nDepends on t, so photolysis follows the sun ACROSS the solve rather than being frozen at the window start — and it is pure arithmetic (sin/cos/min/max), so it traces under Reactant.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "latp",
              "lonp"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "min",
              "args": [
                1.0,
                {
                  "op": "max",
                  "args": [
                    -1.0,
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "sin",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    0.017453292519943295,
                                    {
                                      "op": "index",
                                      "args": [
                                        "latp",
                                        "gj"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "sin",
                              "args": [
                                "decl_s"
                              ]
                            }
                          ]
                        },
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "cos",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    0.017453292519943295,
                                    {
                                      "op": "index",
                                      "args": [
                                        "latp",
                                        "gj"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "cos",
                              "args": [
                                "decl_s"
                              ]
                            },
                            {
                              "op": "cos",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    0.017453292519943295,
                                    {
                                      "op": "-",
                                      "args": [
                                        {
                                          "op": "/",
                                          "args": [
                                            {
                                              "op": "+",
                                              "args": [
                                                "tstmin_s",
                                                {
                                                  "op": "*",
                                                  "args": [
                                                    4.0,
                                                    {
                                                      "op": "index",
                                                      "args": [
                                                        "lonp",
                                                        "gi"
                                                      ]
                                                    }
                                                  ]
                                                }
                                              ]
                                            },
                                            4.0
                                          ]
                                        },
                                        180.0
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "F_RH": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "gf_t",
            "gf_lev",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A3dyn relative humidity w.r.t. liquid water (dimensionless 0-1), two bracketing records, NATIVE [time,lev,lat,lon]. Coupled from GEOSFP.GEOSFP_A3dyn.RH. A3dyn cadence, so it blends with w_A3 (the 3-hourly MEANS at 01:30Z), NOT w_I3."
        },
        "H2Oc": {
          "type": "observed",
          "units": "ppb",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Water vapour volume mixing ratio (ppb), computed EXACTLY as the reference implementation does. GasChem.jl's `couple2(SuperFastCoupler, GEOSFPCoupler)` and `couple2(FastJXCoupler, GEOSFPCoupler)` (ext/EarthSciDataExt.jl) both set H2O via\n    water_concentration_ppb(RH, p, T):\n      Tc   = T - 273.15\n      es   = 6.112 * exp(17.62*Tc/(Tc+243.12)) * 100   [hPa -> Pa]\n      e    = RH * es\n      ppb  = (e/p) * 1e9\nwith RH = GEOSFP A3dyn RH, p = GEOSFP P and T = GEOSFP I3 T -- here Pc and Tc respectively. 611.2 below is the 6.112 hPa coefficient already in Pa.\n\nDrives BOTH FastJX.H2O (the O(1D)+H2O branching behind j_o32OH) and SuperFast.H2O (the H2O+NO2 reaction and the HO2+HO2 water enhancement), exactly as the reference couples both. A constant tropospheric value here is not merely inaccurate, it is unstable: the O(1D)->2OH branching is a function of the H2O MIXING RATIO alone, so a fixed 1.84% overstates the OH yield ~3,300x above 12 km and drove a HOx runaway that killed the solver 20 simulated minutes into a dawn run at NLEV=72.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "F_RH",
              "Tc",
              "Pc"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                1000000000.0,
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "+",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "-",
                                  "args": [
                                    1.0,
                                    "w_A3"
                                  ]
                                },
                                {
                                  "op": "index",
                                  "args": [
                                    "F_RH",
                                    1,
                                    "gk",
                                    {
                                      "op": "+",
                                      "args": [
                                        29,
                                        "gj"
                                      ]
                                    },
                                    {
                                      "op": "+",
                                      "args": [
                                        14,
                                        "gi"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "*",
                              "args": [
                                "w_A3",
                                {
                                  "op": "index",
                                  "args": [
                                    "F_RH",
                                    2,
                                    "gk",
                                    {
                                      "op": "+",
                                      "args": [
                                        29,
                                        "gj"
                                      ]
                                    },
                                    {
                                      "op": "+",
                                      "args": [
                                        14,
                                        "gi"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "op": "*",
                          "args": [
                            611.2,
                            {
                              "op": "exp",
                              "args": [
                                {
                                  "op": "/",
                                  "args": [
                                    {
                                      "op": "*",
                                      "args": [
                                        17.62,
                                        {
                                          "op": "-",
                                          "args": [
                                            {
                                              "op": "index",
                                              "args": [
                                                "Tc",
                                                "gi",
                                                "gj",
                                                "gk"
                                              ]
                                            },
                                            273.15
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "op": "+",
                                      "args": [
                                        {
                                          "op": "-",
                                          "args": [
                                            {
                                              "op": "index",
                                              "args": [
                                                "Tc",
                                                "gi",
                                                "gj",
                                                "gk"
                                              ]
                                            },
                                            273.15
                                          ]
                                        },
                                        243.12
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "Pc",
                        "gi",
                        "gj",
                        "gk"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "F_TS": {
          "type": "parameter",
          "units": "K",
          "shape": [
            "gf_t",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A1 surface skin temperature TS, two bracketing records, NATIVE [time,lat,lon]. A1 cadence -> blends with w_A1."
        },
