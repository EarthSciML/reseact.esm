                            0.02897
                          ]
                        },
                        0.0280101
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "Exy_CO",
                        "gi",
                        "gj"
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        1.0,
                        "days_in_month"
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        "g0",
                        {
                          "op": "index",
                          "args": [
                            "delp",
                            "gi",
                            "gj",
                            "gk"
                          ]
                        }
