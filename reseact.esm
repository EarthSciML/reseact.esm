        "NO_emis": {
          "type": "observed",
          "units": "ppb/s",
          "description": "NEI2016 NO emission rate for SuperFast.NO, ppb/s, in the surface layer only. Chain: the regridded month-integrated flux density E_NO / days_in_month -> a true per-second flux; / (delp/g0) [kg/m^2] -> kg/kg/s; x 1e9*MW_air/MW_species -> ppb/s. The unit factor is spelled 1e9*0.02897/0.03001 so its provenance stays legible: it is uconv/MW_X from GasChem.jl couple2(SuperFastCoupler, NEI2016MonthlyEmisCoupler), the same constant EarthSciModels/couplings/nei2016_superfast.esm carries. The upstream component's dimensionless Dz placeholder is dropped (it is 1.0 there, and a no-op).",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "args": [
              "Exy_NO",
              "delp",
              "diurnal_factor_nox",
              "dayofweek_nox"
            ],
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<",
                  "args": [
                    "gk",
                    2.0
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            1000000000.0,
                            0.02897
                          ]
                        },
                        0.03001
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "Exy_NO",
                        "gi",
                        "gj"
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        1.0,
                        "days_in_month"
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        "g0",
                        {
                          "op": "index",
                          "args": [
                            "delp",
                            "gi",
                            "gj",
                            "gk"
                          ]
                        }
                      ]
                    },
                    "scale",
                    {
                      "op": "index",
                      "args": [
                        "diurnal_factor_nox",
                        "gi"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "dayofweek_nox",
                        "gi"
                      ]
                    }
                  ]
                },
                0.0
              ]
            }
          },
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        },
