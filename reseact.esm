          "type": "parameter",
          "units": "m",
          "shape": [
            "gf_t",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A1 roughness length Z0M, two bracketing records, NATIVE [time,lat,lon]. A1 cadence -> blends with w_A1."
        },
        "F_USTAR": {
          "type": "parameter",
          "units": "m/s",
          "shape": [
            "gf_t",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A1 friction velocity USTAR, two bracketing records, NATIVE [time,lat,lon]. A1 cadence -> blends with w_A1."
        },
        "F_SWGDN": {
          "type": "parameter",
          "units": "W/m^2",
          "shape": [
            "gf_t",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A1 downward shortwave SWGDN, two bracketing records, NATIVE [time,lat,lon]. A1 cadence -> blends with w_A1."
        },
        "F_HFLUX": {
          "type": "parameter",
          "units": "W/m^2",
          "shape": [
            "gf_t",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A1 sensible heat flux HFLUX (+ve upward), two bracketing records, NATIVE [time,lat,lon]. A1 cadence -> blends with w_A1."
        },
        "F_CLOUD": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "gf_t",
            "gf_lev",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A3cld cloud fraction CLOUD, two bracketing records, NATIVE [time,lev,lat,lon]. 3-hourly mean cadence -> blends with w_A3."
        },
        "F_PFLCU": {
          "type": "parameter",
          "units": "kg/m^2/s",
          "shape": [
            "gf_t",
            "gf_lev",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A3mstE convective rain flux PFLCU, two bracketing records, NATIVE [time,lev,lat,lon]. 3-hourly mean cadence -> blends with w_A3."
        },
        "F_PFLLSAN": {
          "type": "parameter",
          "units": "kg/m^2/s",
          "shape": [
            "gf_t",
            "gf_lev",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A3mstE large-scale+anvil rain flux PFLLSAN, two bracketing records, NATIVE [time,lev,lat,lon]. 3-hourly mean cadence -> blends with w_A3."
        },
        "TSc": {
          "type": "observed",
          "units": "K",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "GEOS-FP A1 surface skin temperature on the local grid, broadcast down the column (it is a SURFACE field; only lev=1 uses it, since Wesley gates every k_X on ifelse(lev==1,1,0)). Constants and formulas are AtmosphericDeposition.jl ext/EarthSciDataExt.jl verbatim.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "F_TS"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        1.0,
                        "w_A1"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "F_TS",
