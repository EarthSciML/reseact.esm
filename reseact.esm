    },
    "DryDepositionGas": {
      "ref": "../EarthSciModels/components/atmospheric_deposition/wesley_dry_gas.esm"
    },
    "WetDeposition": {
      "ref": "../EarthSciModels/components/atmospheric_deposition/wet_deposition.esm"
    },
    "SuperFastDepositionSink": {
      "ref": "../EarthSciModels/components/atmospheric_deposition/superfast_deposition_sink.esm"
    },
    "NEI2016Emis": {
      "ref": "../EarthSciModels/components/earthsci_data/nei2016_monthly.esm"
    },
    "NEIRegrid": {
      "expression_template_imports": [
        {
          "ref": "../EarthSciDiscretizations/regridding/conservative_overlap.esm",
          "prefix": "ov",
          "bindings": {
            "NSRC": {
              "op": "*",
              "args": [
                "NEI_NX",
                "NEI_NY"
              ]
            },
            "NTGT": {
              "op": "*",
              "args": [
                "NLON",
                "NLAT"
              ]
            },
            "NVERT": 4
          }
        },
        {
          "ref": "../EarthSciDiscretizations/regridding/cartesian_cell_rings.esm",
          "prefix": "src",
          "bindings": {
            "GX": "NEI_NX",
            "GY": "NEI_NY"
          }
        },
        {
          "ref": "../EarthSciDiscretizations/regridding/cartesian_cell_rings.esm",
          "prefix": "tgt",
          "bindings": {
            "GX": "NLON",
            "GY": "NLAT"
          }
        },
        {
          "ref": "../EarthSciDiscretizations/reprojection/lambert_conformal.esm",
          "prefix": "lcc"
        }
      ],
      "variables": {
        "src_x0": {
          "type": "parameter",
          "units": "m",
          "default": -2556000.0,
          "description": "12US1 XORIG: the WEST EDGE of source column 1 in Lambert metres. cartesian_cell_rings_poly takes x0/y0 as the SW cell EDGE, which is exactly what IOAPI's XORIG/YORIG are, so these transfer verbatim."
        },
        "src_y0": {
          "type": "parameter",
          "units": "m",
          "default": -1728000.0,
          "description": "12US1 YORIG: the SOUTH EDGE of source row 1 (Lambert metres)."
        },
        "src_dx": {
          "type": "parameter",
          "units": "m",
          "default": 12000.0,
          "description": "12US1 XCELL: source cell width (m)."
        },
        "src_dy": {
          "type": "parameter",
          "units": "m",
          "default": 12000.0,
          "description": "12US1 YCELL: source cell height (m)."
        },
        "lcc_lat_1": {
          "type": "parameter",
          "units": "deg",
          "default": 33.0,
          "description": "12US1 P_ALP: first standard parallel."
        },
        "lcc_lat_2": {
          "type": "parameter",
          "units": "deg",
          "default": 45.0,
          "description": "12US1 P_BET: second standard parallel."
        },
        "lcc_lat_0": {
          "type": "parameter",
          "units": "deg",
          "default": 40.0,
          "description": "12US1 YCENT: origin latitude."
        },
        "lcc_lon_0": {
          "type": "parameter",
          "units": "deg",
          "default": -97.0,
          "description": "12US1 P_GAM/XCENT: central meridian."
        },
        "lcc_R": {
          "type": "parameter",
          "units": "m",
          "default": 6370997.0,
          "description": "12US1 sphere radius. The projection is spherical (+a=+b=6370997), so the spherical Snyder forms in the ESD library are EXACT here, not an approximation of an ellipsoidal grid."
        },
        "lon0_deg": {
          "type": "parameter",
          "units": "deg",
          "default": -112.5,
          "description": "West EDGE of the target slice, in degrees. MUST equal Transport3D.lon0_deg (= -182.5 + 5*LON0); `native_slice` sets both from one origin. Disagreement puts the emissions on a different grid than the meteorology, silently."
        },
        "lat0_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 26.0,
          "description": "Southern-most lat POINT of the target slice. MUST equal Transport3D.lat0_deg (= -90 + 4*LAT0). Note this is a cell CENTRE, so the ring builder below is handed lat0_deg - dlat_deg/2 as its south edge."
        },
        "dlon_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 5.0,
          "description": "GEOS-FP 4x5 zonal cell width."
        },
        "dlat_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 4.0,
          "description": "GEOS-FP 4x5 meridional cell width."
        },
        "atol": {
          "type": "parameter",
          "units": "1",
          "default": 1e-12,
          "description": "Sliver floor for the gated overlap: candidate pairs whose clipped area is <= atol are dropped from both the weights and the apply."
        },
        "scale": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Uniform emissions scaling knob (1 = inventory as published). Mirrors NEI2016MonthlyEmis.scale; NOT the days-in-month fix, which is applied below as physics."
        },
        "t_ref": {
          "type": "parameter",
          "units": "s",
          "default": 1451606400.0,
          "description": "Reference epoch (Unix s) that model time t is measured from: 2016-01-01T00:00:00Z, the EPOCH_DATE of split_common.jl. Sets which calendar month days_in_month normalises by and where local time falls."
        },
        "g0": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.80665,
          "description": "Standard gravity, for the pressure-thickness -> column-mass conversion (delp/g0 is kg/m^2)."
        },
        "F_NO": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "NEI2016 NO on the native 12US1 grid, in the file's own [TSTEP, LAY, ROW, COL] dim order (measured off the provider, not assumed). UNITS ARE A MONTHLY TOTAL IN SHORT TONS PER CELL despite the file's `tons/day` attribute and the loader's declared kg/m^2/s: the EPA gridded-merge monthly files store a whole month's emissions on a single 24-hour TSTEP. The ESM loader is pure I/O and converts nothing, so PHI_NO below carries the whole chain (/days_in_month, short tons -> kg, / cell area). Same class of gap as F_PS's hPa-vs-Pa. See EarthSciData.jl issue #209.",
          "shape": [
            "nei_t",
            "nei_lay",
            "nei_row",
            "nei_col"
          ]
        },
        "F_NO2": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "NEI2016 NO2 on the native 12US1 grid, in the file's own [TSTEP, LAY, ROW, COL] dim order (measured off the provider, not assumed). UNITS ARE A MONTHLY TOTAL IN SHORT TONS PER CELL despite the file's `tons/day` attribute and the loader's declared kg/m^2/s: the EPA gridded-merge monthly files store a whole month's emissions on a single 24-hour TSTEP. The ESM loader is pure I/O and converts nothing, so PHI_NO2 below carries the whole chain (/days_in_month, short tons -> kg, / cell area). Same class of gap as F_PS's hPa-vs-Pa. See EarthSciData.jl issue #209.",
          "shape": [
            "nei_t",
            "nei_lay",
            "nei_row",
            "nei_col"
          ]
        },
        "F_CO": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "NEI2016 CO on the native 12US1 grid, in the file's own [TSTEP, LAY, ROW, COL] dim order (measured off the provider, not assumed). UNITS ARE A MONTHLY TOTAL IN SHORT TONS PER CELL despite the file's `tons/day` attribute and the loader's declared kg/m^2/s: the EPA gridded-merge monthly files store a whole month's emissions on a single 24-hour TSTEP. The ESM loader is pure I/O and converts nothing, so PHI_CO below carries the whole chain (/days_in_month, short tons -> kg, / cell area). Same class of gap as F_PS's hPa-vs-Pa. See EarthSciData.jl issue #209.",
          "shape": [
            "nei_t",
            "nei_lay",
            "nei_row",
            "nei_col"
          ]
        },
        "F_ISOP": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "NEI2016 ISOP on the native 12US1 grid, in the file's own [TSTEP, LAY, ROW, COL] dim order (measured off the provider, not assumed). UNITS ARE A MONTHLY TOTAL IN SHORT TONS PER CELL despite the file's `tons/day` attribute and the loader's declared kg/m^2/s: the EPA gridded-merge monthly files store a whole month's emissions on a single 24-hour TSTEP. The ESM loader is pure I/O and converts nothing, so PHI_ISOP below carries the whole chain (/days_in_month, short tons -> kg, / cell area). Same class of gap as F_PS's hPa-vs-Pa. See EarthSciData.jl issue #209.",
          "shape": [
            "nei_t",
            "nei_lay",
            "nei_row",
            "nei_col"
          ]
        },
        "F_FORM": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "NEI2016 FORM on the native 12US1 grid, in the file's own [TSTEP, LAY, ROW, COL] dim order (measured off the provider, not assumed). UNITS ARE A MONTHLY TOTAL IN SHORT TONS PER CELL despite the file's `tons/day` attribute and the loader's declared kg/m^2/s: the EPA gridded-merge monthly files store a whole month's emissions on a single 24-hour TSTEP. The ESM loader is pure I/O and converts nothing, so PHI_FORM below carries the whole chain (/days_in_month, short tons -> kg, / cell area). Same class of gap as F_PS's hPa-vs-Pa. See EarthSciData.jl issue #209.",
          "shape": [
            "nei_t",
            "nei_lay",
            "nei_row",
            "nei_col"
          ]
        },
        "delp": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "First-level pressure thickness (Pa), coupled from Transport3D.delP1. delp/g0 is the surface layer's column mass (kg/m^2), the divisor that turns an emission FLUX into a mixing-ratio rate. This is the live hydrostatic value; the upstream component instead interpolates a 94x49 CLIMATOLOGICAL delp_dry_surface table, which reseact does not need because it already carries the real surface pressure.",
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        },
        "lev": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Vertical index k as a field, coupled from Transport3D.levc. Emissions are injected into the surface layer only (the lev < 2 gate), matching NEI2016MonthlyEmis.",
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        },
        "src_poly_xy": {
          "type": "observed",
          "units": "m",
          "description": "Source cell corner rings on the 12US1 Lambert grid, in metres, row-major over (row, col) with col fastest -- the same flattening the IOAPI array has in memory, so source cell c and F_*[1, 1, row(c), col(c)] name the same cell.",
          "expression": {
            "op": "apply_expression_template",
            "name": "src.cartesian_cell_rings_poly",
            "args": [],
            "bindings": {
              "x0": "src_x0",
              "y0": "src_y0",
              "dx": "src_dx",
              "dy": "src_dy"
            }
          },
          "shape": [
            "ov.src_cells",
            "ov.overlap_cell_verts",
            "ov.overlap_coord"
          ]
        },
        "src_poly": {
          "type": "observed",
          "units": "deg",
          "description": "Source rings reprojected from Lambert metres to lon/lat, per vertex (Snyder eqs. 14-9/14-11 for lon, 15-5 for lat). Reprojecting the SOURCE rather than the target is 137,241x4 inverse projections against the target's 91x4 -- deliberately the expensive direction, because it is the one that stays correct when GEOS-FP is swapped for a higher-resolution product. Build-time only: measured at 244,837,944 node lowerings, 161 s, 1.36 GB peak, and the cascade tally comes back EMPTY -- none of this geometry reaches the per-step RHS.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "c",
              "v",
              "k"
            ],
            "ranges": {
              "c": {
                "from": "ov.src_cells"
              },
              "v": {
                "from": "ov.overlap_cell_verts"
              },
              "k": {
                "from": "ov.overlap_coord"
              }
            },
            "args": [
              "src_poly_xy"
            ],
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<",
                  "args": [
                    "k",
                    2
                  ]
                },
                {
                  "op": "apply_expression_template",
                  "name": "lcc.lambert_conformal_inverse_lon",
                  "args": [],
                  "bindings": {
                    "x": {
                      "op": "index",
                      "args": [
                        "src_poly_xy",
                        "c",
                        "v",
                        1
                      ]
                    },
                    "y": {
                      "op": "index",
                      "args": [
                        "src_poly_xy",
                        "c",
                        "v",
                        2
                      ]
                    },
                    "lat_1": "lcc_lat_1",
                    "lat_2": "lcc_lat_2",
                    "lat_0": "lcc_lat_0",
                    "lon_0": "lcc_lon_0",
                    "R": "lcc_R"
                  }
                },
                {
                  "op": "apply_expression_template",
                  "name": "lcc.lambert_conformal_inverse_lat",
                  "args": [],
                  "bindings": {
                    "x": {
                      "op": "index",
                      "args": [
                        "src_poly_xy",
                        "c",
                        "v",
                        1
                      ]
                    },
                    "y": {
                      "op": "index",
                      "args": [
                        "src_poly_xy",
                        "c",
                        "v",
                        2
                      ]
                    },
                    "lat_1": "lcc_lat_1",
                    "lat_2": "lcc_lat_2",
                    "lat_0": "lcc_lat_0",
                    "lon_0": "lcc_lon_0",
                    "R": "lcc_R"
                  }
                }
              ]
            }
          },
          "shape": [
            "ov.src_cells",
            "ov.overlap_cell_verts",
            "ov.overlap_coord"
          ]
        },
        "src_coslat": {
          "type": "observed",
          "units": "1",
          "description": "cos(latitude) at each source cell centre, taken as the mean of its four reprojected ring latitudes. THIS IS THE AREA CORRECTION that makes a PLANAR degree-space overlap mass-conserving: clipping in (lon, lat) weights by dlon*dlat, but true area is R^2*cos(phi)*dlon*dlat, so a flux density premultiplied by cos(phi) and normalised by the cos-weighted target area (A_full) reproduces the spherical answer to the small-cell approximation. Without it a 12 km cell at 49N would be over-weighted ~1.5x relative to one at 25N.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "c"
            ],
            "ranges": {
              "c": {
                "from": "ov.src_cells"
              }
            },
            "args": [
              "src_poly"
            ],
            "expr": {
              "op": "cos",
              "args": [
                {
                  "op": "*",
                  "args": [
                    0.017453292519943295,
                    {
                      "op": "*",
                      "args": [
                        0.25,
                        {
                          "op": "+",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "src_poly",
                                "c",
                                1,
                                2
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "src_poly",
                                "c",
                                2,
                                2
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "src_poly",
                                "c",
                                3,
                                2
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "src_poly",
                                "c",
                                4,
                                2
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "shape": [
            "ov.src_cells"
          ]
        },
        "tgt_poly": {
          "type": "observed",
          "units": "deg",
          "description": "Target cell corner rings in lon/lat, row-major over (lat, lon) with lon fastest, so target cell j = (gj-1)*NLON + gi. x0 is lon0_deg (already a west EDGE) but y0 is lat0_deg - dlat_deg/2, because lat0_deg is the southern-most lat POINT.",
          "expression": {
            "op": "apply_expression_template",
            "name": "tgt.cartesian_cell_rings_poly",
            "args": [],
            "bindings": {
              "x0": "lon0_deg",
              "y0": {
                "op": "-",
                "args": [
                  "lat0_deg",
                  {
                    "op": "/",
                    "args": [
                      "dlat_deg",
                      2.0
                    ]
                  }
                ]
              },
              "dx": "dlon_deg",
              "dy": "dlat_deg"
            }
          },
          "shape": [
            "ov.tgt_cells",
            "ov.overlap_cell_verts",
            "ov.overlap_coord"
          ]
        },
        "A_full": {
          "type": "observed",
          "units": "deg^2",
          "description": "cos-weighted FULL area of each target cell: dlon * (sin(phi_N) - sin(phi_S)) * 180/pi. This is the normaliser the emissions apply divides by -- deliberately NOT conservative_overlap_A_j_gated, which row-sums the COVERED area only. The NEI domain does not tile the CONUS slice (ocean, Canada, Mexico), and normalising by covered area would smear a coastal cell's few covered source cells across the whole cell and multiply its emissions by the inverse coverage fraction. Dividing by the full cell area instead leaves the uncovered fraction correctly emitting nothing.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "j"
            ],
            "ranges": {
              "j": {
                "from": "ov.tgt_cells"
              }
            },
            "args": [
              "tgt_poly"
            ],
            "expr": {
              "op": "*",
              "args": [
                "dlon_deg",
                57.29577951308232,
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "sin",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            0.017453292519943295,
                            {
                              "op": "index",
                              "args": [
                                "tgt_poly",
                                "j",
                                3,
                                2
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "op": "sin",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            0.017453292519943295,
                            {
                              "op": "index",
                              "args": [
                                "tgt_poly",
                                "j",
                                1,
                                2
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "shape": [
            "ov.tgt_cells"
          ]
        },
        "A_ij": {
          "type": "observed",
          "units": "deg^2",
          "description": "Overlap area of every (source, target) pair that survives the join.overlap broad phase -- the 'overlap index' method: an STRtree over inflated ring bounding boxes admits a product term only for candidate pairs, so one polygon clip runs per candidate instead of per (i,j) of the 137,241 x 91 product. Planar manifold: the spherical clip needs the GeometryOps extension, and src_coslat/A_full already carry the area correction that matters at these latitudes.",
          "expression": {
            "op": "apply_expression_template",
            "name": "ov.conservative_overlap_A_ij_gated",
            "args": [],
            "bindings": {
              "src_poly": "src_poly",
              "tgt_poly": "tgt_poly",
              "manifold": "planar"
            }
          },
          "shape": [
            "ov.src_cells",
            "ov.tgt_cells"
          ]
        },
        "PHI_NO": {
          "type": "observed",
          "units": "kg/m^2/s",
          "description": "NEI2016 NO flattened onto the source-cell enumeration and converted to a flux density (kg/m^2/s, still carrying the month's total rather than a daily rate -- the /days_in_month is applied on the target grid): file value (short tons per cell for the month) x 907.185/86400 (EarthSciData to_unit's `tons/day` scale) / (dx*dy), then x cos(lat) for the planar-overlap area correction. The remaining /days_in_month is applied on the target grid, where it is one scalar rather than 137,241 of them.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "c"
            ],
            "ranges": {
              "c": {
                "from": "ov.src_cells"
              }
            },
            "args": [
              "F_NO",
