              ]
            }
          }
        },
        "dp_col": {
          "type": "observed",
          "units": "Pa",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Column mass sum_k dp(k) = PS - P_top. The weight the pressure-fixer correction is distributed by, so the correction is MASS-weighted rather than uniform in k.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj"
            ],
            "args": [
              "dp"
            ],
            "reduce": "+",
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "index",
              "args": [
                "dp",
                "gi",
                "gj",
                "gk"
              ]
            }
          }
        },
        "divh_fix": {
          "type": "observed",
          "units": "Pa/s",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Pressure-FIXED horizontal divergence:\n    divh_fix(k) = divh(k) + (-dPSdt - divh_col) * dp(k)/dp_col\nGEOS-FP archives U/V/OMEGA as 3-hourly MEANS but PS as an INSTANTANEOUS field, so the discrete identity d(dp)/dt + div(M) = 0 does not hold and the column budget misses by (dPSdt + divh_col). Measured on this model: the air mass drifts from its own hydrostatic thickness at a CONSTANT rate -- 4.6e-3 rms per 300 s step at 21x13x72, dead linear, worst cells at k=1 -- until a cell reaches zero and the solve dies (3.6-5.2 h).\n\nThe residual is spread over the column in proportion to dp, so the correction is mass-weighted and vanishes where there is no mass. This is the COLUMN-LOCAL fixer: it enforces sum_k divh_fix = -dPSdt exactly, per column, with no global coupling. The variational (Poisson) fixer of Jockel et al. (2001) would distribute the same total correction more smoothly in the horizontal, but it is a global elliptic solve -- neither pointwise nor a stencil, so the splitter could not separate it and a Reactant trace would have to carry an iterative solver. The column-local form removes the drain without any of that.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "divh",
              "dPSdt",
              "divh_col",
              "dp",
              "dp_col"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "divh",
                    "gi",
                    "gj",
                    "gk"
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        {
                          "op": "neg",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "dPSdt",
                                "gi",
                                "gj"
                              ]
                            }
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "divh_col",
                            "gi",
                            "gj"
                          ]
                        }
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "dp",
                            "gi",
                            "gj",
                            "gk"
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "dp_col",
                            "gi",
                            "gj"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "Mz": {
          "type": "observed",
          "units": "Pa/s",
          "shape": [
            "lon",
            "lat",
            "lev_nodes"
          ],
          "description": "Vertical face-normal AIR-MASS flux (Pa/s) at each cell's LOWER edge, +ve UPWARD, DIAGNOSED FROM CONTINUITY rather than read from GEOS-FP OMEGA:\n    Mz[ke] = - sum_{k < ke} ( dB[k]*dPSdt + divh_fix(k) )\nan exclusive forward scan over lev (esm-spec 4.3.1 cumulative reductions; filter j < i). Mz[1] = 0 falls out as the empty-set additive identity -- no flux through the ground -- and Mz[NLEV+1] = 0 falls out BECAUSE divh_fix makes the column budget close. So both no-flux walls the facediv_lev_mass_nf_k1/_kN stencils assume are now SATISFIED rather than merely asserted.\n\nThis replaces Mz = -OMEGA. Taking OMEGA directly is what made m drift from dp (Jockel et al. 2001): OMEGA is a 3-hourly MEAN while PS is INSTANTANEOUS, so the two never closed the same budget. Diagnosing Mz instead means the vertical flux CANNOT be inconsistent -- it is defined as whatever closes continuity. Note F_OM is consequently no longer read by the dynamics.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gke"
            ],
            "args": [
              "dB",
              "dPSdt",
              "divh_fix"
            ],
            "reduce": "+",
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gke": {
                "from": "lev_nodes"
              },
              "gk": {
                "from": "lev"
              }
            },
            "filter": {
              "op": "<",
              "args": [
                "gk",
                "gke"
              ]
            },
            "expr": {
              "op": "neg",
              "args": [
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "dB",
                            "gk"
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "dPSdt",
                            "gi",
                            "gj"
                          ]
                        }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "divh_fix",
                        "gi",
                        "gj",
                        "gk"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "F_PS": {
          "type": "parameter",
          "units": "hPa",
          "shape": [
            "gf_t",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP I3 surface pressure on the NATIVE 4x5 grid, the two records bracketing the current time: [time,lat,lon] = [gf_t,gf_lat,gf_lon]. Coupled from GEOSFP.GEOSFP_I3.PS. UNITS ARE hPa, not the Pa the loader declares — the file says hPa and EarthSciIO returns raw values, so every consumer here scales by 100."
        },
        "F_U": {
          "type": "parameter",
          "units": "m/s",
          "shape": [
            "gf_t",
            "gf_lev",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A3dyn eastward wind, two bracketing records, NATIVE [time,lev,lat,lon]. Coupled from GEOSFP.GEOSFP_A3dyn.U. CELL-CENTRED (A-grid) despite the loader's 'x-edge-staggered' note — the archived GEOS-Chem files are A-grid — so it is averaged to lon faces here."
        },
        "F_V": {
          "type": "parameter",
          "units": "m/s",
          "shape": [
            "gf_t",
            "gf_lev",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A3dyn northward wind, two bracketing records, NATIVE [time,lev,lat,lon]. Coupled from GEOSFP.GEOSFP_A3dyn.V. Cell-centred; averaged to lat faces here."
        },
        "F_OM": {
          "type": "parameter",
          "units": "Pa/s",
          "shape": [
            "gf_t",
            "gf_lev",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A3dyn vertical pressure velocity OMEGA = dP/dt, +ve DOWNWARD, two bracketing records, NATIVE [time,lev,lat,lon]. Coupled from GEOSFP.GEOSFP_A3dyn.OMEGA. Cell-centred; averaged to lev edges and NEGATED to give Mz (+ve upward)."
        },
        "F_PBLH": {
          "type": "parameter",
          "units": "m",
          "shape": [
            "gf_t",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A1 planetary boundary layer height, two bracketing records, NATIVE [time,lat,lon]. Coupled from GEOSFP.GEOSFP_A1.PBLH. Carried for the Kzz parameterization."
        },
        "w_I3": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Time-interpolation weight for the I3 cadence (PS): 3-hourly INSTANTANEOUS records at 00:00, 03:00, ... UTC. Coupled from GEOSFP.w_time_I3."
        },
        "w_A3": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Time-interpolation weight for the A3 cadence (U/V/OMEGA): 3-hourly time-AVERAGED records centred 01:30, 04:30, ... UTC. Coupled from GEOSFP.w_time_A3. Distinct from w_I3 because GEOS-FP's collections are not co-phased."
        },
        "w_A1": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Time-interpolation weight for the A1 cadence (PBLH): hourly time-AVERAGED records centred 00:30, 01:30, ... UTC. Coupled from GEOSFP.w_time_A1."
        },
        "PBLH": {
          "type": "observed",
          "units": "m",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Planetary boundary layer height (m) on the local grid: the GEOS-FP A1 field at NATIVE (lat=LAT0+j, lon=LON0+i), blended across its two bracketing records with w_A1. Carried for the Kzz parameterization; not yet consumed by the transport RHS.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj"
            ],
            "args": [
              "F_PBLH"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        1.0,
                        "w_A1"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "F_PBLH",
                        1,
                        {
                          "op": "+",
                          "args": [
                            "LAT0",
                            "gj"
                          ]
                        },
                        {
                          "op": "+",
                          "args": [
                            "LON0",
                            "gi"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    "w_A1",
                    {
                      "op": "index",
                      "args": [
                        "F_PBLH",
                        2,
                        {
                          "op": "+",
                          "args": [
                            "LAT0",
                            "gj"
                          ]
                        },
                        {
                          "op": "+",
                          "args": [
                            "LON0",
                            "gi"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "F_T": {
          "type": "parameter",
          "units": "K",
          "shape": [
            "gf_t",
            "gf_lev",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP I3 temperature, two bracketing records, NATIVE [time,lev,lat,lon]. Coupled from GEOSFP.GEOSFP_I3.T. Declared K and delivered K — unlike PS, no unit gap here (verified against the file)."
        },
        "Tc": {
          "type": "observed",
          "units": "K",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Air temperature (K) on the local grid: the GEOS-FP I3 field at NATIVE (lev=k, lat=LAT0+j, lon=LON0+i), blended across its two bracketing records with w_I3. Coupled into SuperFast.T; param_to_var carries this grid shape onto the scalar param so the pointwise lift indexes it per cell.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "F_T"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        1.0,
                        "w_I3"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "F_T",
                        1,
                        "gk",
                        {
                          "op": "+",
                          "args": [
                            "LAT0",
                            "gj"
                          ]
                        },
                        {
                          "op": "+",
                          "args": [
                            "LON0",
                            "gi"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    "w_I3",
                    {
                      "op": "index",
                      "args": [
                        "F_T",
                        2,
                        "gk",
                        {
                          "op": "+",
                          "args": [
                            "LAT0",
                            "gj"
                          ]
                        },
                        {
                          "op": "+",
                          "args": [
                            "LON0",
                            "gi"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "Ap": {
          "type": "parameter",
          "units": "Pa",
          "shape": [
            "lev_nodes"
          ],
          "default": 0.0,
          "description": "GEOS-FP hybrid sigma-pressure Ap coefficients at the NLEV+1 layer edges (Pa). k=1 is the surface (Ap[1]=0, Bp[1]=1 => P_edge(1)=PS). Supplied via const_arrays."
        },
        "Bp": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lev_nodes"
          ],
          "default": 0.0,
          "description": "GEOS-FP hybrid sigma-pressure Bp coefficients at the NLEV+1 layer edges (dimensionless). Supplied via const_arrays."
        },
        "Pc": {
          "type": "observed",
          "units": "Pa",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Air pressure (Pa) at each layer's mid-point: the mean of its two hybrid sigma-pressure edges, P_edge(k) = Ap[k] + Bp[k]*PS(i,j,t). Breathes with the real surface pressure. Coupled into SuperFast.P.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "Ap",
              "Bp",
              "PS"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                0.5,
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "Ap",
                            "gk"
                          ]
                        },
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "Bp",
                                "gk"
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "PS",
                                "gi",
                                "gj"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "Ap",
                            {
                              "op": "+",
                              "args": [
                                "gk",
                                1
                              ]
                            }
                          ]
                        },
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "Bp",
                                {
                                  "op": "+",
                                  "args": [
                                    "gk",
                                    1
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "PS",
                                "gi",
                                "gj"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "latp": {
          "type": "observed",
          "units": "deg",
          "shape": [
            "lat"
          ],
          "description": "Latitude of each lat POINT, lat_j = lat0_deg + (j-1)*dlat_deg, from the latlon grid's own lat_coord template (the same producer lat_edge folds from). Pure geometry, no forcing. Feeds latc.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lat_coord",
            "bindings": {}
          }
        },
        "lonp": {
          "type": "observed",
          "units": "deg",
          "shape": [
            "lon"
          ],
          "description": "Longitude of each lon cell CENTRE, lon_i = lon0_deg + (i-1/2)*dlon_deg, from the latlon grid's own lon_coord template (lon0_deg is the west EDGE, hence the half-cell shift). Feeds lonc.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lon_coord",
            "bindings": {}
          }
        },
        "doy0": {
          "type": "observed",
          "units": "1",
          "description": "Day of year (1..366) of the model's t=0 epoch. The model's time base: solver time t is seconds since 2016-01-01T00:00:00Z (unix 1451606400), the GEOS-FP day the meteorology is read from — so the runners' T0 = 64800 is 18:00Z that day. Retarget the run to another date by editing doy0 / hour0 / min0 / sec0 together with the GEOS-FP URL in prototypes/reseact_3d_chem/split_common.jl `reseact_forcing`.",
          "expression": 1.0
        },
        "hour0": {
          "type": "observed",
          "units": "1",
          "description": "UTC hour of the model's t=0 epoch. See doy0.",
          "expression": 0.0
        },
        "min0": {
          "type": "observed",
          "units": "1",
          "description": "UTC minute of the model's t=0 epoch. See doy0.",
          "expression": 0.0
        },
        "sec0": {
          "type": "observed",
          "units": "1",
          "description": "UTC second of the model's t=0 epoch. See doy0.",
          "expression": 0.0
        },
        "gamma_s": {
          "type": "observed",
          "units": "rad",
          "description": "NOAA fractional-year angle gamma = 0.01721420632103996 * ((doy0-1) + (hour0-12)/24 + t/86400).\n\nThis is fastjx.esm's `gamma` with ONE change: the elapsed-time term t/86400 replaces the calendar decomposition of a UTC timestamp. That change is what lets the sun MOVE with the solve. The upstream form calls datetime.day_of_year / datetime.hour on t_utc, which EarthSciAST evaluates as opaque host calls (Dates.unix2datetime) — they cannot take the solver's t, and under Reactant they cannot even take a literal, because the tree-walk evaluator lowers every leaf as convert(T, ...) and T is a TracedRNumber. Decomposing the calendar ONCE at the epoch (doy0/hour0/min0/sec0 above, plain literals) and advancing it with arithmetic is exact, traceable, and continuous.\n\nAgrees with the upstream form to the last bit whenever t is a whole number of hours past the epoch; between hours it is strictly BETTER, because upstream's `hour` is an integer truncation that steps gamma once an hour (a ~7e-4 rad phase error) while this is smooth.",
          "expression": {
            "op": "*",
            "args": [
              0.01721420632103996,
              {
                "op": "+",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "doy0",
                      1.0
                    ]
                  },
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          "hour0",
                          12.0
                        ]
                      },
                      24.0
                    ]
                  },
                  {
                    "op": "/",
                    "args": [
                      "t",
                      86400.0
                    ]
                  }
                ]
              }
            ]
          }
        },
        "decl_s": {
          "type": "observed",
          "units": "rad",
          "description": "Solar declination (rad) — Spencer (1971) 6-term Fourier series in gamma_s. Term for term identical to fastjx.esm `solar_declination`.",
          "expression": {
            "op": "+",
            "args": [
              0.006918,
              {
                "op": "*",
                "args": [
                  -0.399912,
                  {
                    "op": "cos",
                    "args": [
                      "gamma_s"
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.070257,
                  {
                    "op": "sin",
                    "args": [
                      "gamma_s"
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  -0.006758,
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          2.0,
                          "gamma_s"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.000907,
                  {
                    "op": "sin",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          2.0,
                          "gamma_s"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  -0.002697,
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          3.0,
                          "gamma_s"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  0.00148,
                  {
                    "op": "sin",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          3.0,
                          "gamma_s"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "eqtime_s": {
          "type": "observed",
          "units": "1",
          "description": "Equation of time (minutes): 229.18*(0.000075 + 0.001868 cos g - 0.032077 sin g - 0.014615 cos 2g - 0.040849 sin 2g). Identical to fastjx.esm `equation_of_time`.",
          "expression": {
            "op": "*",
            "args": [
              229.18,
              {
                "op": "+",
                "args": [
                  7.5e-05,
                  {
                    "op": "*",
                    "args": [
                      0.001868,
                      {
                        "op": "cos",
                        "args": [
                          "gamma_s"
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      -0.032077,
                      {
                        "op": "sin",
                        "args": [
                          "gamma_s"
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      -0.014615,
                      {
                        "op": "cos",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              2.0,
                              "gamma_s"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      -0.040849,
                      {
                        "op": "sin",
                        "args": [
                          {
                            "op": "*",
                            "args": [
                              2.0,
                              "gamma_s"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "tstmin_s": {
          "type": "observed",
          "units": "1",
          "description": "True solar time at the PRIME MERIDIAN, in minutes since midnight: hour0*60 + min0 + sec0/60 + t/60 + eqtime_s. The per-cell 4*lon term (4 min per degree east) is added inside cos_sza_c, so this stays scalar and only the cheap longitude offset is done per cell.",
          "expression": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "hour0",
                  60.0
                ]
              },
              "min0",
              {
                "op": "/",
                "args": [
                  "sec0",
                  60.0
                ]
              },
              {
                "op": "/",
                "args": [
                  "t",
                  60.0
                ]
              },
              "eqtime_s"
            ]
          }
        },
        "cos_sza_c": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Cosine of the solar zenith angle per cell: clamp(sin(lat)sin(decl) + cos(lat)cos(decl)cos(w), -1, 1), with hour angle w = (pi/180)*((tstmin_s + 4*lon)/4 - 180). Coupled into FastJX.cos_sza — the single solar input of the interpolated Fast-JX component, which (unlike fastjx.esm) does NOT compute the solar position itself.\n\nShaped [lon,lat,lev] even though it is invariant in lev: every FastJX input (cos_sza, T, P) then carries the SAME axes, so the shape promotion that lifts the 0-D photolysis chain onto the grid never has to align differently-shaped operands by name. The duplicated column costs one extra observed and nothing at all in the j-rates, which are recomputed per cell regardless.\n\nDepends on t, so photolysis follows the sun ACROSS the solve rather than being frozen at the window start — and it is pure arithmetic (sin/cos/min/max), so it traces under Reactant.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gi",
              "gj",
              "gk"
            ],
            "args": [
              "latp",
              "lonp"
            ],
            "ranges": {
              "gi": {
                "from": "lon"
              },
              "gj": {
                "from": "lat"
              },
              "gk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "min",
              "args": [
                1.0,
                {
                  "op": "max",
                  "args": [
                    -1.0,
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "sin",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    0.017453292519943295,
                                    {
                                      "op": "index",
                                      "args": [
                                        "latp",
                                        "gj"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "sin",
                              "args": [
                                "decl_s"
                              ]
                            }
                          ]
                        },
                        {
