  "index_sets": {
    "gf_t": {
      "kind": "interval",
      "size": 2
    },
    "gf_lev": {
      "kind": "interval",
      "size": 72
    },
    "gf_lat": {
      "kind": "interval",
      "size": 46
    },
    "gf_lon": {
      "kind": "interval",
      "size": 72
    }
  },
  "coupling": [
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_I3.PS",
      "to": "Transport3D.F_PS",
      "transform": "param_to_var",
      "description": "GEOS-FP I3 surface pressure (hPa in file) -> the native-slice PS. Note the subsystem key is GEOSFP_I3, not I3."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.U",
      "to": "Transport3D.F_U",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn eastward wind -> the zonal face flux Mx."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.V",
      "to": "Transport3D.F_V",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn northward wind -> the meridional face flux My."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A3dyn.OMEGA",
      "to": "Transport3D.F_OM",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn OMEGA -> the vertical face flux Mz = -OMEGA."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_A1.PBLH",
      "to": "Transport3D.F_PBLH",
      "transform": "param_to_var",
      "description": "GEOS-FP A1 boundary-layer height -> carried for Kzz."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_I3",
      "to": "Transport3D.w_I3",
      "transform": "param_to_var",
      "description": "I3 cadence weight -> the PS two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_A3",
      "to": "Transport3D.w_A3",
      "transform": "param_to_var",
      "description": "A3 cadence weight -> the U/V/OMEGA two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.w_time_A1",
      "to": "Transport3D.w_A1",
      "transform": "param_to_var",
      "description": "A1 cadence weight -> the PBLH two-record blend."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.GEOSFP_I3.T",
      "to": "Transport3D.F_T",
      "transform": "param_to_var",
      "description": "GEOS-FP I3 temperature -> the native-slice Tc."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Tc",
      "to": "SuperFast.T",
      "transform": "param_to_var",
      "description": "Per-cell GEOS-FP temperature -> SuperFast's scalar T param. param_to_var carries the [lon,lat,lev] shape so the pointwise lift indexes it per cell; the rate constants then vary with the real 3-D temperature field."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Pc",
      "to": "SuperFast.P",
      "transform": "param_to_var",
      "description": "Per-cell hybrid mid-layer pressure -> SuperFast's scalar P param."
    },
    {
      "type": "operator_compose",
      "systems": [
        "SuperFast",
        "Transport3D"
      ],
      "lifting": "pointwise",
      "description": "Lift the 0-D SuperFast mechanism onto the 7x7x7 grid and add each species' PPM advection contribution to its reaction tendency. pointwise lifting evaluates the network independently per cell; the merged reaction+advection state ODEs are array-ified by the flattener's lift. Only the 12 non-constant species lift — O2/CH4/H2O are constant:true reservoirs with no ODE, so they broadcast into the rates instead."
    }
  ],
  "reaction_systems": {
    "SuperFast": {
      "ref": "../../../EarthSciModels/components/gaschem/superfast.esm"
    }
  }
}
