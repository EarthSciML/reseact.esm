              "op": "+",
              "args": [
                2.0,
                {
                  "op": "*",
                  "args": [
                    0.5,
                    {
                      "op": "sin",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            0.017453292519943295,
                            {
                              "op": "+",
                              "args": [
                                20.0,
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "-",
