     }
    },
    {
     "lhs": {
      "op": "ic",
      "args": [
       "mq"
      ]
     },
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "i",
       "j",
       "k"
      ],
      "ranges": {
       "i": {
        "from": "lon"
       },
       "j": {
        "from": "lat"
       },
       "k": {
        "from": "lev"
       }
      },
      "args": [],
      "expr": {
       "op": "+",
       "args": [
        2.0,
        {
         "op": "*",
         "args": [
          0.5,
          {
           "op": "sin",
