{
 "esm": "0.8.0",
 "metadata": {
  "name": "ReSEACT_Transport3D",
  "description": "ReSEACT 3-D transport foundation: monotone PPM on the latlon3d grid over a 7x7x7 CONUS-centered NATIVE slice of GEOS-FP 4x5 (no regridding). Horizontal = regional open-wall inflow BCs (ppm_flux_D_{lon,lat}_mono_inflow_bc + face_flux_divergence_{lon,lat}_open_bc); vertical = hybrid sigma-pressure massform (ppm_flux_D_lev_mono_hybrid_noflux_bc + face_flux_divergence_lev_massform_noflux_bc). All six rules imported BY REFERENCE. Gate: CWC -- q=mq/m must stay EXACTLY 1 and dev EXACTLY 0.",
  "license": "MIT",
  "tags": [
   "esd:problem",
   "grid:latlon3d",
   "family:finite_volume",
   "op:D",
   "axes:lon,lat,lev",
   "scheme:flux_form",
   "property:free_stream",
   "bc:inflow"
  ]
 },
 "models": {
  "Transport3D": {
   "expression_template_imports": [
    {
     "ref": "../../../EarthSciDiscretizations/grids/latlon3d/rules/face_flux_divergence_lon_open_bc.esm",
     "bindings": {
      "NLON": 7,
      "NLAT": 7,
      "NLEV": 7
     }
    },
    {
     "ref": "../../../EarthSciDiscretizations/grids/latlon3d/rules/face_flux_divergence_lat_open_bc.esm",
     "bindings": {
      "NLON": 7,
      "NLAT": 7,
      "NLEV": 7
     }
    },
    {
     "ref": "../../../EarthSciDiscretizations/grids/latlon3d/rules/ppm_flux_D_lon_mono_inflow_bc.esm",
     "bindings": {
      "NLON": 7,
      "NLAT": 7,
      "NLEV": 7
     }
    },
    {
     "ref": "../../../EarthSciDiscretizations/grids/latlon3d/rules/ppm_flux_D_lat_mono_inflow_bc.esm",
     "bindings": {
      "NLON": 7,
      "NLAT": 7,
      "NLEV": 7
     }
    },
    {
     "ref": "../../../EarthSciDiscretizations/grids/latlon3d/rules/ppm_flux_D_lev_mono_hybrid_noflux_bc.esm",
     "bindings": {
      "NLON": 7,
      "NLAT": 7,
      "NLEV": 7
     }
    },
    {
     "ref": "../../../EarthSciDiscretizations/grids/latlon3d/rules/face_flux_divergence_lev_massform_noflux_bc.esm",
     "bindings": {
      "NLON": 7,
      "NLAT": 7,
      "NLEV": 7
     }
    }
   ],
   "variables": {
    "m": {
     "type": "state",
     "units": "1",
     "shape": [
      "lon",
      "lat",
      "lev"
     ],
     "description": "Air mass per cell (a pressure thickness). Strictly positive."
    },
    "mq": {
     "type": "state",
     "units": "1",
     "shape": [
      "lon",
      "lat",
      "lev"
     ],
     "description": "Tracer mass per cell. Initialised bitwise equal to m, so q == 1."
    },
    "dev": {
     "type": "state",
     "units": "1",
     "shape": [
      "lon",
      "lat",
      "lev"
     ],
     "description": "Diagnostic deviation dev = mq - m, obtained by integrating the DIFFERENCE of the two right-hand sides from dev(0) = 0. This is the quantity the conformance assertion gates: at q == 1 the tracer divergence collapses bitwise onto the continuity divergence, so dev's own right-hand side is EXACTLY 0.0 in IEEE and dev never leaves zero. It exists because assertion `reference` expressions are build-time and cellwise and cannot read states or observeds, so q itself is not assertable and asserting mq would require re-spelling the entire discrete divergence by hand -- i.e. duplicating the operator inside its own test. Against a constant-zero reference there is nothing for the test to get wrong. dev feeds nothing back into m or mq."
    },
    "lon0_deg": {
     "type": "parameter",
     "units": "deg",
     "default": -112.5,
     "description": "West EDGE of the slice. GEOS-FP 4x5 lon cell edges are -182.5+5*(i-1); -112.5 is the edge of native cell i=15, so cells i=15..21 (centers -110..-80) map to lon_local 1..7 with NO interpolation."
    },
    "lat0_deg": {
     "type": "parameter",
     "units": "deg",
     "default": 26.0,
     "description": "Southern-most lat POINT of the slice. GEOS-FP 4x5 lat points are -90+4*(j-1); 26 is native j=30, so points j=30..36 (26..50) map to lat_local 1..7 with NO interpolation."
    },
    "dlon_deg": {
     "type": "observed",
     "units": "deg",
     "expression": 5.0,
     "description": "GEOS-FP 4x5 native zonal spacing. Open west/east walls (regional, not periodic)."
    },
    "dlat_deg": {
     "type": "observed",
     "units": "deg",
     "expression": 4.0,
     "description": "GEOS-FP 4x5 native meridional spacing. Open south/north walls (regional, not polar)."
    },
    "phie": {
     "type": "observed",
     "units": "deg",
     "shape": [
      "lat_nodes"
     ],
     "description": "Latitude cell EDGES from the grid's lat_edge template; the half-polar caps fall out of the clamp at +/-90.",
     "expression": {
      "op": "apply_expression_template",
      "args": [],
      "name": "lat_edge",
      "bindings": {}
     }
    },
    "coslat_e": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lat_nodes"
     ],
     "description": "cos of the latitude edges. Zero-length face at each pole. Never read at faces 1 or NLAT+1 -- the pole terms are structurally omitted.",
     "expression": {
      "op": "apply_expression_template",
      "args": [],
      "name": "coslat_edge",
      "bindings": {
       "phie": "phie"
      }
     }
    },
    "dS_lat": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lat"
     ],
     "description": "Exact spherical cell-area weight sin(phie[j+1]) - sin(phie[j]).",
     "expression": {
      "op": "apply_expression_template",
      "args": [],
      "name": "latcell_area",
      "bindings": {
       "phie": "phie"
      }
     }
    },
    "dphi_lat": {
     "type": "observed",
     "units": "rad",
     "shape": [
      "lat"
     ],
     "description": "Meridional cell extent; HALF-width at the two polar caps.",
     "expression": {
      "op": "apply_expression_template",
      "args": [],
      "name": "latcell_dphi",
      "bindings": {
       "phie": "phie"
      }
     }
    },
    "Mx": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lon_nodes",
      "lat",
      "lev"
     ],
     "description": "Zonal face-normal air-mass flux at the WEST edge of each cell. Element NLON+1 IS read here (open east wall). Positive throughout [0,60] deg lon, so the west wall is inflow and the east wall outflow.",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "ci",
       "cj",
       "ck"
      ],
      "args": [
       "phie"
      ],
      "ranges": {
       "ci": {
        "from": "lon_nodes"
       },
       "cj": {
        "from": "lat"
       },
       "ck": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        0.7,
        {
         "op": "cos",
         "args": [
          {
           "op": "*",
           "args": [
            0.017453292519943295,
            {
             "op": "+",
             "args": [
              "lon0_deg",
              {
               "op": "*",
               "args": [
                {
                 "op": "-",
                 "args": [
                  "ci",
                  1
                 ]
                },
                "dlon_deg"
               ]
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "op": "+",
         "args": [
          1.0,
          {
           "op": "*",
           "args": [
            0.3,
            {
             "op": "sin",
             "args": [
              {
               "op": "*",
               "args": [
                0.017453292519943295,
                {
                 "op": "*",
                 "args": [
                  0.5,
                  {
                   "op": "+",
                   "args": [
                    {
                     "op": "index",
                     "args": [
                      "phie",
                      "cj"
                     ]
                    },
                    {
                     "op": "index",
                     "args": [
                      "phie",
                      {
                       "op": "+",
                       "args": [
                        "cj",
                        1
                       ]
                      }
                     ]
                    }
                   ]
                  }
                 ]
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "op": "+",
         "args": [
          1.0,
          {
           "op": "*",
           "args": [
            0.05,
            {
             "op": "-",
             "args": [
              "ck",
              1
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     }
    },
    "My": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lon",
      "lat_nodes",
      "lev"
     ],
     "description": "Meridional face-normal air-mass flux at the SOUTH edge of each cell. Faces 1 and NLAT+1 are the open south/north walls (real face lengths, NOT poles). Positive across the patch, so the south wall is inflow and the north wall outflow.",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "ci",
       "cj",
       "ck"
      ],
      "args": [
       "phie"
      ],
      "ranges": {
       "ci": {
        "from": "lon"
       },
       "cj": {
        "from": "lat_nodes"
       },
       "ck": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "*",
       "args": [
        0.5,
        {
         "op": "sin",
         "args": [
          {
           "op": "*",
           "args": [
            2.0,
            {
             "op": "*",
             "args": [
              0.017453292519943295,
              {
               "op": "+",
               "args": [
                "lon0_deg",
                {
                 "op": "*",
                 "args": [
                  {
                   "op": "-",
                   "args": [
                    "ci",
                    0.5
                   ]
                  },
                  "dlon_deg"
                 ]
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "op": "cos",
         "args": [
          {
           "op": "*",
           "args": [
            0.017453292519943295,
            {
             "op": "index",
             "args": [
              "phie",
              "cj"
             ]
            }
           ]
          }
         ]
        },
        {
         "op": "+",
         "args": [
          1.0,
          {
           "op": "*",
           "args": [
            0.05,
            {
             "op": "-",
             "args": [
              "ck",
              1
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     }
    },
    "q": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lon",
      "lat",
      "lev"
     ],
     "description": "Mixing ratio mq/m. The quantity under test: it must stay EXACTLY 1.",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "iq",
       "jq",
       "kq"
      ],
      "args": [
       "mq",
       "m"
      ],
      "ranges": {
       "iq": {
        "from": "lon"
       },
       "jq": {
        "from": "lat"
       },
       "kq": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "/",
       "args": [
        {
         "op": "index",
         "args": [
          "mq",
          "iq",
          "jq",
          "kq"
         ]
        },
        {
         "op": "index",
         "args": [
          "m",
          "iq",
          "jq",
          "kq"
         ]
        }
       ]
      }
     }
    },
    "qbc_w": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lat",
      "lev"
     ],
     "description": "Prescribed tracer concentration in the WEST halo (Dirichlet inflow data), == 1 so the incoming tracer matches the interior and q stays 1. The falsifier perturbs this.",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "gl",
       "gl"
      ],
      "args": [],
      "ranges": {
       "gl": {
        "from": "lev"
       }
      },
      "expr": 1.0
     }
    },
    "qbc_e": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lat",
      "lev"
     ],
     "description": "Prescribed tracer concentration in the EAST halo, == 1.",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "gl",
       "gl"
      ],
      "args": [],
      "ranges": {
       "gl": {
        "from": "lev"
       }
      },
      "expr": 1.0
     }
    },
    "qbc_s": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lon",
      "lev"
     ],
     "description": "Prescribed tracer concentration in the SOUTH halo, == 1.",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "gl",
       "gl"
      ],
      "args": [],
      "ranges": {
       "gl": {
        "from": "lev"
       }
      },
      "expr": 1.0
     }
    },
    "qbc_n": {
     "type": "observed",
     "units": "1",
     "shape": [
      "lon",
      "lev"
     ],
     "description": "Prescribed tracer concentration in the NORTH halo, == 1.",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "gl",
       "gl"
      ],
      "args": [],
      "ranges": {
       "gl": {
        "from": "lev"
       }
      },
      "expr": 1.0
     }
    },
    "dA": {
     "type": "parameter",
     "units": "Pa",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "dA[k] = Ap[k]-Ap[k+1] from the native GEOS-FP hybrid table at integer edges k=1..8. Supplied via const_arrays."
    },
    "dB": {
     "type": "parameter",
     "units": "1",
     "shape": [
      "lev"
     ],
     "default": 0.0,
     "description": "dB[k] = Bp[k]-Bp[k+1] from the native GEOS-FP hybrid table at integer edges k=1..8. Supplied via const_arrays."
    },
    "PS": {
     "type": "observed",
     "units": "Pa",
     "shape": [
      "lon",
      "lat"
     ],
     "description": "Surface pressure. STAGE B: constant 101325 Pa. Stage A replaces this with the GEOS-FP I3.PS native slice (i=14+lon, j=29+lat).",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "gi",
       "gj"
      ],
      "ranges": {
       "gi": {
        "from": "lon"
       },
       "gj": {
        "from": "lat"
       }
      },
      "args": [],
      "expr": 101325.0
     }
    },
    "dp": {
     "type": "observed",
     "units": "Pa",
     "shape": [
      "lon",
      "lat",
      "lev"
     ],
     "description": "Physical pressure thickness dp = dA[k] + dB[k]*Ps(i,j,t) on the GEOS-FP hybrid sigma-pressure grid; the CW84 parabola is built on these (ppmflux_D_lev_hyb_*). dA/dB are differences of the native GEOS-FP Ap(Pa)/Bp tables at integer edges k=1..8 -- read directly, NOT via interp.linear, which keeps the transport RHS pure arithmetic and therefore autodiff-capable.",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "gi",
       "gj",
       "gk"
      ],
      "ranges": {
       "gi": {
        "from": "lon"
       },
       "gj": {
        "from": "lat"
       },
       "gk": {
        "from": "lev"
       }
      },
      "args": [
       "PS",
       "dA",
       "dB"
      ],
      "expr": {
       "op": "+",
       "args": [
        {
         "op": "index",
         "args": [
          "dA",
          "gk"
         ]
        },
        {
         "op": "*",
         "args": [
          {
           "op": "index",
           "args": [
            "dB",
            "gk"
           ]
          },
          {
           "op": "index",
           "args": [
            "PS",
            "gi",
            "gj"
           ]
          }
         ]
        }
       ]
      }
     }
    },
    "Mz": {
     "type": "observed",
     "units": "Pa/s",
     "shape": [
      "lon",
      "lat",
      "lev_nodes"
     ],
     "description": "Vertical face-normal air-mass flux at the LOWER edge of each cell, positive UPWARD. Vanishes exactly at k=1 (surface) and k=NLEV+1 (lid), consistent with the no-flux hybrid BC. STAGE B: analytic. Stage A: Mz = -OMEGA (OMEGA is dP/dt, +ve DOWNWARD, and is already lev-interface staggered in GEOS-FP).",
     "expression": {
      "op": "aggregate",
      "output_idx": [
       "ci",
       "cj",
       "ck"
      ],
      "ranges": {
       "ci": {
        "from": "lon"
       },
       "cj": {
        "from": "lat"
       },
       "ck": {
        "from": "lev_nodes"
       }
      },
      "args": [],
      "expr": {
       "op": "*",
       "args": [
        0.05,
        {
         "op": "*",
         "args": [
          4.0,
          {
           "op": "/",
           "args": [
            {
             "op": "-",
             "args": [
              "ck",
              1
             ]
            },
            7.0
           ]
          },
          {
           "op": "-",
           "args": [
            1.0,
            {
             "op": "/",
             "args": [
              {
               "op": "-",
               "args": [
                "ck",
                1
               ]
              },
              7.0
             ]
            }
           ]
          },
          {
           "op": "-",
           "args": [
            1.0,
            {
             "op": "*",
             "args": [
              2.0,
              {
               "op": "/",
               "args": [
                {
                 "op": "-",
                 "args": [
                  "ck",
                  1
                 ]
                },
                7.0
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     }
    }
   },
   "tests": [
    {
     "id": "freestream_q_stays_one_regional_inflow",
     "description": "MEASURED: on a mid-latitude regional patch with OPEN lateral walls carrying a prescribed boundary concentration qbc == 1, the mixing ratio q = mq/m stays EXACTLY 1 under a divergent air-mass flux with genuine inflow (west, south) and outflow (east, north). At q == 1 with the halo == 1 every CW84 slope is a difference of equal values and is exactly 0.0 in IEEE, the reconstruction is the constant 1 through the walls, and each open wall flux collapses to F = M bitwise, so the inflow PPM tracer divergence telescopes onto the open-wall continuity twin and dmq/dt equals dm/dt to the last bit. The reference is the CONSTANT ZERO, so 0.0 proves nothing alone -- non-vacuity is problems/_falsifier_regional_inflow.esm (all four qbc halos x 1.000001), which injects a mismatched boundary concentration through the inflow walls and drives dev off zero, correctly FAILING. Only the t>0 assertion discriminates: dev integrates from dev(0)=0.",
     "time_span": {
      "start": 0.0,
      "end": 0.1
     },
     "assertions": [
      {
       "variable": "dev",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "abs": 1e-12
       },
       "reduce": "Linf_error",
       "reference": {
        "op": "aggregate",
        "output_idx": [
         "i",
         "j",
         "k"
        ],
        "args": [],
        "ranges": {
         "i": {
          "from": "lon"
         },
         "j": {
          "from": "lat"
         },
         "k": {
          "from": "lev"
         }
        },
        "expr": 0.0
       }
      },
      {
       "variable": "dev",
       "time": 0.1,
       "expected": 0.0,
       "tolerance": {
        "abs": 1e-12
       },
       "reduce": "Linf_error",
       "reference": {
        "op": "aggregate",
        "output_idx": [
         "i",
         "j",
         "k"
        ],
        "args": [],
        "ranges": {
         "i": {
          "from": "lon"
         },
         "j": {
          "from": "lat"
         },
         "k": {
          "from": "lev"
         }
        },
        "expr": 0.0
       }
      }
     ]
    }
   ],
   "equations": [
    {
     "lhs": {
      "op": "ic",
      "args": [
       "m"
      ]
     },
     "rhs": {
      "op": "aggregate",
      "output_idx": [
       "i",
       "j",
       "k"
      ],
      "ranges": {
       "i": {
        "from": "lon"
       },
       "j": {
        "from": "lat"
       },
       "k": {
        "from": "lev"
       }
      },
      "args": [],
      "expr": {
       "op": "+",
       "args": [
        2.0,
        {
         "op": "*",
         "args": [
          0.5,
          {
           "op": "sin",
           "args": [
            {
             "op": "*",
             "args": [
              0.017453292519943295,
              {
               "op": "+",
               "args": [
                20.0,
                {
                 "op": "*",
                 "args": [
                  {
                   "op": "-",
                   "args": [
                    "j",
                    1
                   ]
                  },
                  5.0
                 ]
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "op": "*",
         "args": [
          0.1,
          {
           "op": "cos",
           "args": [
            {
             "op": "*",
             "args": [
              0.017453292519943295,
              {
               "op": "*",
               "args": [
                {
                 "op": "-",
                 "args": [
                  "i",
                  0.5
                 ]
                },
                5.0
