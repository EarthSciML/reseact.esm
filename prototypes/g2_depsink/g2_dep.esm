{
  "esm": "1.0.0",
  "metadata": {
    "name": "g2_depsink_dep",
    "description": "G2 (with deposition): SuperFast mounted BY REF + shared SuperFastDepositionSink mounted BY REF + operator_compose merge of the -k*c sink onto chemistry. 0-D, 1 s. k rates set via simulate parameters (exaggerated for a visible 1 s effect)."
  },
  "reaction_systems": {
    "SuperFast": {
      "ref": "../../../EarthSciModels/components/gaschem/superfast.esm"
    }
  },
  "models": {
    "SuperFastDepositionSink": {
      "ref": "../../../EarthSciModels/components/atmospheric_deposition/superfast_deposition_sink.esm"
    }
  },
  "coupling": [
    {
      "type": "operator_compose",
      "systems": [
        "SuperFast",
        "SuperFastDepositionSink"
      ],
      "description": "Sum the D(SuperFast.<X>) ~ -(k_dry+k_wet)*X deposition sink equations onto the SuperFast chemistry ODEs."
    }
  ]
}
